<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- CS0618: tests deliberately exercise the [Obsolete] LaunchPlan.CommandLine
         plaintext API for backward-compat verification (see LaunchPlan.cs:29). -->
    <!-- WT1003: test fixture setup legitimately uses LauncherStore.Save for test infrastructure -->
    <!-- CA2000/CA2213: tests own their lifecycle via test fixtures -->
    <NoWarn>$(NoWarn);CS0618;WT1003;CA2000;CA2213</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="TngTech.ArchUnitNET" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="MSBuild.CompilerCache" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WTLauncher.App\WTLauncher.App.csproj" />
    <!-- Dual role for the analyzer project: OutputItemType=Analyzer makes the
         custom analyzers run on test code (WT1001-WT1006 enforcement), while the
         plain reference below gives the in-process analyzer test suite the
         assembly. Both entries are required — MSBuild keeps them as distinct
         items (different OutputItemType), and the test output must carry the dll. -->
    <ProjectReference Include="..\..\src\WTLauncher.Analyzers\WTLauncher.Analyzers.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\src\WTLauncher.Analyzers\WTLauncher.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\WTLauncher.Core\WTLauncher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- The analyzer project reference is not reliably copied to the test output
       folder by incremental builds (ProjectReference + OutputItemType=Analyzer
       interplay). The in-process analyzer test suite needs the dll at runtime,
       so copy it explicitly after every build of the tests project. -->
  <Target Name="CopyAnalyzerAssemblyToTestOutput" AfterTargets="Build">
    <Copy SourceFiles="..\..\src\WTLauncher.Analyzers\bin\$(Configuration)\netstandard2.0\WTLauncher.Analyzers.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

