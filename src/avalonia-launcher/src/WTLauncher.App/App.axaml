<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="WTLauncher.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <!-- Design Tokens — injected at runtime from WTLauncher.Core.LauncherDesignTokens.cs via App.axaml.cs -->
  </Application.Resources>
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />

    <!--
      ── Global control skin ─────────────────────────────────────────────
      Foreground controls carry elevation + focus; shared by every window
      unless a local class overrides a property.
    -->

    <!-- Typography baseline -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Accent/destructive buttons keep their project color semantics on the Semi base.
         /template/ overrides are required: Semi's own hover/pressed styles target
         PART_ContentPresenter directly, so a plain Button.Background setter would
         be overridden and the red would fade to gray on hover. -->
    <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DestructiveBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DestructiveBrush}"/>
    </Style>
    <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DestructiveHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DestructiveHoverBrush}"/>
    </Style>
    <Style Selector="Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DestructivePressedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DestructivePressedBrush}"/>
    </Style>
    <Style Selector="Button.destructive:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DestructiveDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DestructiveDisabledForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DestructiveDisabledBackgroundBrush}"/>
    </Style>

    <!-- Accent button: interaction states read the user-chosen accent ramp,
         injected at runtime from LauncherSettings.AccentColor (default sky-700).
         FluentTheme's accent class follows the OS accent color (often gray),
         so we override every interaction state explicitly. -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentNormalBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentNormalBrush}"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentDisabledForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDisabledBackgroundBrush}"/>
    </Style>

  </Application.Styles>
</Application>
