<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
        x:Class="WTLauncher.App.Views.CommandManagementWindow"
        x:DataType="vm:CommandManagementViewModel"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="600"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
    <Style Selector="Button.tab.active">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
    </Style>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Text="{Binding Heading}"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 Margin="0,4,0,12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="{Binding Description}"/>
      <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{Binding CommandTab}"
                  MinWidth="130"
                  Classes="secondary tab"
                  Classes.active="{Binding IsCommandTabActive}"
                  Command="{Binding SelectCommandTabCommand}"
                  automation:AutomationProperties.Name="{Binding CommandTabAutomation}"/>
          <Button Content="{Binding TemplateTab}"
                  MinWidth="130"
                  Classes="secondary tab"
                  Classes.active="{Binding IsTemplateTabActive}"
                  Command="{Binding SelectTemplateTabCommand}"
                  automation:AutomationProperties.Name="{Binding TemplateTabAutomation}"/>
          <TextBlock Margin="12,6,0,0"
                     Text="{Binding StatusMessage}"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"
                     automation:AutomationProperties.Name="{Binding StatusAutomation}"/>
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,6,0,0"
                    IsVisible="{Binding IsCommandTabActive}">
          <Button Content="{Binding EditRenameLabel}"
                  Classes="secondary"
                  MinWidth="90"
                  IsEnabled="{Binding HasSelectedCommand}"
                  Click="OnRenameCommandClicked"
                  automation:AutomationProperties.Name="{Binding EditRenameAutomation}"/>
          <Button Content="{Binding DeleteLabel}"
                  Classes="secondary"
                  MinWidth="90"
                  IsEnabled="{Binding HasSelectedCommand}"
                  Command="{Binding DeleteCommandCommand}"
                  automation:AutomationProperties.Name="{Binding DeleteAutomation}"/>
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,6,0,0"
                    IsVisible="{Binding IsTemplateTabActive}">
          <Button Content="{Binding NewTemplateLabel}" Classes="secondary" MinWidth="90"
                  Click="OnAddTemplateClicked"
                  automation:AutomationProperties.Name="{Binding NewTemplateAutomation}"/>
          <Button Content="{Binding UpdateKeyLabel}" Classes="secondary" MinWidth="90"
                  IsEnabled="{Binding HasSelectedTemplate}" Click="OnUpdateTemplateKeyClicked"
                  automation:AutomationProperties.Name="{Binding UpdateKeyAutomation}"/>
          <Button Content="{Binding UpdateValueLabel}" Classes="secondary" MinWidth="110"
                  IsEnabled="{Binding HasSelectedTemplate}" Click="OnUpdateTemplateValueClicked"
                  automation:AutomationProperties.Name="{Binding UpdateValueAutomation}"/>
          <Button Content="{Binding DeleteTemplateLabel}" Classes="secondary" MinWidth="90"
                  IsEnabled="{Binding HasSelectedTemplate}" Command="{Binding DeleteTemplateCommand}"
                  automation:AutomationProperties.Name="{Binding DeleteTemplateAutomation}"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="3"
              BorderThickness="1"
              CornerRadius="10"
              BorderBrush="{StaticResource CardBorderBrush}"
              Padding="8">
        <Grid>
          <Grid IsVisible="{Binding IsCommandTabActive}">
            <ListBox Classes="management-list"
                     ItemsSource="{Binding CommandRows}"
                     SelectedItem="{Binding SelectedCommandRow, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:CommandRow">
                  <Border Classes="management-row" DoubleTapped="OnCommandRowDoubleTapped">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                      <TextBlock Grid.Column="0" Classes="mono-command" Text="{Binding Command}"/>
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding ReferencingEntryNames}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Classes="muted-detail" Text="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Column="4" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding $parent[Window].((vm:CommandManagementViewModel)DataContext).ReferencePrefix}"/><Run Text="{Binding ReferenceCount}"/>
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding HasNoCommandRows}"
                       Margin="8,12"
                       Text="{Binding EmptyCommandsLabel}"
                       Foreground="{StaticResource TextMutedBrush}"
                       automation:AutomationProperties.Name="{Binding EmptyCommandsAutomation}"/>
          </Grid>
          <Grid IsVisible="{Binding IsTemplateTabActive}">
            <ListBox Classes="management-list"
                     ItemsSource="{Binding TemplateRows}"
                     SelectedItem="{Binding SelectedTemplateRow, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TemplateRow">
                  <Border Classes="management-row" DoubleTapped="OnTemplateRowDoubleTapped">
                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                      <TextBlock Grid.Column="0" Classes="mono-command">
                        <Run Text="$"/><Run Text="{Binding Key}"/>
                      </TextBlock>
                      <TextBlock Grid.Column="2" Classes="muted-detail"
                                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                 Text="{Binding ExpandedValue}"/>
                      <TextBlock Grid.Column="4" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding $parent[Window].((vm:CommandManagementViewModel)DataContext).ReferencePrefix}"/><Run Text="{Binding ReferenceCount}"/>
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding HasNoTemplateRows}"
                       Margin="8,12"
                       Text="{Binding EmptyTemplatesLabel}"
                       Foreground="{StaticResource TextMutedBrush}"
                       automation:AutomationProperties.Name="{Binding EmptyTemplatesAutomation}"/>
          </Grid>
        </Grid>
      </Border>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource DialogFooterMargin}">
        <Button Content="{Binding CloseLabel}" Classes="primary" MinWidth="110" Click="OnCloseClicked"
                automation:AutomationProperties.Name="{Binding CloseAutomation}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
