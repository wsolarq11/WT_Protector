<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        x:Class="WTLauncher.App.Views.ConfirmBatchLaunchWindow"
        Width="760"
        Height="520"
        MinWidth="460"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
      <TextBlock Grid.Row="0"
                 x:Name="TitleText"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 x:Name="MessageText"
                 Margin="0,0,0,4"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <Border Grid.Row="2"
              BorderThickness="1"
              CornerRadius="{StaticResource ControlCornerRadius}"
              BorderBrush="{StaticResource CardBorderBrush}"
              Padding="12">
        <ScrollViewer>
          <TextBox x:Name="PlansText"
                   IsReadOnly="True"
                   FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                   FontSize="{StaticResource FontSizeSmall}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="220"
                   BorderThickness="0"/>
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Row="3"
                  x:Name="FailureSection"
                  IsVisible="False"
                  Margin="0,10,0,0"
                  Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}">
        <TextBlock x:Name="FailureHeader"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <Border BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="{StaticResource CardBorderBrush}"
                Padding="12">
          <ScrollViewer>
            <TextBox x:Name="FailureText"
                     IsReadOnly="True"
                     FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                     FontSize="{StaticResource FontSizeSmall}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     BorderThickness="0"/>
          </ScrollViewer>
        </Border>
      </StackPanel>
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button x:Name="CancelButton"
                Classes="secondary"
                MinWidth="96"
                IsCancel="True"
                Click="OnCancelClicked"/>
        <Button Classes="accent"
                x:Name="LaunchButton"
                Click="OnLaunchClicked"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
