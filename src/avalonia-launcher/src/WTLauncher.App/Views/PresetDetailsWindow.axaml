<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="WTLauncher.App.Views.PresetDetailsWindow"
        Width="560"
        Height="260"
        MinWidth="480"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
      <TextBlock Grid.Row="0"
                 x:Name="HeadingText"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 x:Name="SummaryText"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <TextBlock Grid.Row="2"
                 x:Name="NameLabel"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Grid.Row="3"
               x:Name="NameBox"
               FontFamily="Cascadia Code, Consolas, Courier New, monospace"
               FontSize="{StaticResource FontSizeBody}"
               Padding="10,8"/>
      <TextBlock Grid.Row="4"
                 x:Name="ErrorText"
                 IsVisible="False"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource DestructiveBrush}"/>
      <StackPanel Grid.Row="5"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Classes="secondary"
                MinWidth="90"
                IsDefault="True"
                IsCancel="True"
                x:Name="CancelButton"
                Click="OnCancelClicked"/>
        <Button Classes="primary"
                MinWidth="110"
                x:Name="SaveButton"
                Click="OnSaveClicked"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
