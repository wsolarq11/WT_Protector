<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
             xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
             x:Class="WTLauncher.App.Views.Controls.StatusBar"
             x:DataType="vm:MainWindowViewModel">
  <Border Classes="status-panel"
          Classes.status-success="{Binding IsStatusSuccess}"
          Classes.status-warning="{Binding IsStatusWarning}"
          Classes.status-error="{Binding IsStatusError}"
          Background="{StaticResource SurfaceBrush}"
          CornerRadius="16"
          BorderBrush="{StaticResource CardBorderBrush}"
          BorderThickness="1"
          Padding="16">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
      <Grid Width="20" Height="20" Margin="0,0,8,0">
        <!-- Neutral: circle -->
        <Path Data="{StaticResource IconStatusCircle}"
              Stroke="{StaticResource TextMutedBrush}"
              StrokeThickness="2"
              Fill="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="14" Height="14"
              IsVisible="{Binding IsStatusNeutral}"
              automation:AutomationProperties.Name="状态级别"/>
        <!-- Success: check -->
        <Path Data="{StaticResource IconStatusCheck}"
              Stroke="{StaticResource BadgeSuccessForegroundBrush}"
              StrokeThickness="2"
              Fill="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="16" Height="16"
              IsVisible="{Binding IsStatusSuccess}"
              automation:AutomationProperties.Name="状态级别"/>
        <!-- Warning: alert triangle -->
        <Path Data="{StaticResource IconStatusAlert}"
              Stroke="{StaticResource BadgeInfoForegroundBrush}"
              StrokeThickness="2"
              Fill="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="16" Height="16"
              IsVisible="{Binding IsStatusWarning}"
              automation:AutomationProperties.Name="状态级别"/>
        <!-- Error: x -->
        <Path Data="{StaticResource IconStatusX}"
              Stroke="{StaticResource ErrorBrush}"
              StrokeThickness="2"
              Fill="Transparent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="16" Height="16"
              IsVisible="{Binding IsStatusError}"
              automation:AutomationProperties.Name="状态级别"/>
      </Grid>
      <TextBlock Grid.Column="1"
                 Text="{Binding StatusText}"
                 automation:AutomationProperties.Name="状态信息"
                 automation:AutomationProperties.LiveSetting="Polite"
                 FontSize="{StaticResource FontSizeBody}"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBlock Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="mono"
                 Text="{Binding DryRunText}"/>
    </Grid>
  </Border>
</UserControl>
