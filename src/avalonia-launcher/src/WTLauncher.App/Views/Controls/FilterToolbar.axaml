<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
             xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
             x:Class="WTLauncher.App.Views.Controls.FilterToolbar"
             x:DataType="vm:MainWindowViewModel">
  <Grid>
    <Grid x:Name="ControlBoxesGrid"
          ColumnDefinitions="1.8*,1*,1*,2.8*" ColumnSpacing="12" Margin="0,12,0,0">
      <Border Classes="control-box">
        <StackPanel>
          <TextBlock Classes="control-box-label" Text="搜索"/>
          <AutoCompleteBox x:Name="SearchTextBox"
                           automation:AutomationProperties.Name="搜索"
                           PlaceholderText="搜索名称、目录或命令"
                           Text="{Binding FilterText, Mode=TwoWay}"
                           ItemsSource="{Binding SearchHistoryItems}"
                           MinimumPrefixLength="1"
                           MinimumPopulateDelay="0:0:0.150"
                           IsTextCompletionEnabled="False"
                           FontSize="{StaticResource FontSizeEmphasis}" Padding="12,8"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="control-box">
        <StackPanel>
          <TextBlock Classes="control-box-label" Text="排序"/>
          <ComboBox ItemsSource="{Binding SortModes}"
                    SelectedItem="{Binding SelectedSortMode, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="control-box">
        <StackPanel>
          <TextBlock Classes="control-box-label" Text="视图"/>
          <ComboBox x:Name="DisplayModeComboBox"
                    ItemsSource="{Binding DisplayModes}"
                    SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="control-box">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.ColumnSpan="4" Classes="control-box-label" Text="启动组"/>
          <ComboBox Grid.Row="1" ItemsSource="{Binding Presets}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="选择启动组"/>
          <Button Grid.Row="1" Grid.Column="1" Classes="secondary"
                  Content="{Binding ApplyPresetButtonText}" Command="{Binding ApplyPresetCommand}"/>
          <Button Grid.Row="1" Grid.Column="2" Classes="secondary" Content="预演"
                  Command="{Binding PreviewSelectedPresetCommand}"/>
          <Button Grid.Row="1" Grid.Column="3" Classes="primary" Content="启动"
                  AutomationProperties.Name="启动" Command="{Binding LaunchSelectedPresetCommand}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
