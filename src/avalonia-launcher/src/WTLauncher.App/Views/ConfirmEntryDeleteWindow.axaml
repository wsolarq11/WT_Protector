<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="WTLauncher.App.Views.ConfirmEntryDeleteWindow"
        Width="520"
        Height="260"
        MinWidth="480"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <StackPanel Spacing="12">
      <TextBlock x:Name="HeadingText"
                 Classes="dialog-title"/>
      <TextBlock x:Name="BodyText"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Classes="secondary"
                MinWidth="90"
                IsDefault="True"
                IsCancel="True"
                x:Name="CancelButton"
                Click="OnCancelClicked"/>
        <Button Classes="destructive"
                MinWidth="110"
                x:Name="DeleteButton"
                Click="OnDeleteClicked"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
