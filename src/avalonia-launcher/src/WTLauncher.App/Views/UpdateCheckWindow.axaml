<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WTLauncher.App.ViewModels"
        x:Class="WTLauncher.App.Views.UpdateCheckWindow"
        x:DataType="vm:UpdateCheckViewModel"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="300"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
  <StackPanel Spacing="16" Margin="{StaticResource DialogOuterPadding}">
    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSizeEmphasis}" Foreground="{StaticResource TextPrimaryBrush}" />
    <TextBlock Text="{Binding CurrentVersion}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextMutedBrush}" />
    <TextBlock Text="{Binding ErrorMessage}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource BadgeWarningForegroundBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    <TextBlock Text="{Binding LatestVersion}" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}" IsVisible="{Binding HasResult}" />
    <TextBlock Text="{Binding Note}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
  </StackPanel>
</Window>
