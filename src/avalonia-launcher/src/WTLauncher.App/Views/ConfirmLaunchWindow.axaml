<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        x:Class="WTLauncher.App.Views.ConfirmLaunchWindow"
        Width="680"
        Height="360"
        MinWidth="560"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
      <TextBlock Grid.Row="0"
                 x:Name="TitleText"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 x:Name="NoteText"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <TextBox Grid.Row="2"
               x:Name="CommandText"
               IsReadOnly="True"
               FontFamily="Cascadia Code, Consolas"
               FontSize="{StaticResource FontSizeSmall}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="120"/>
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button x:Name="CancelButton"
                Classes="secondary"
                MinWidth="90"
                IsCancel="True"
                Click="OnCancelClicked"/>
        <Button x:Name="LaunchButton"
                Classes="primary"
                MinWidth="110"
                Click="OnLaunchClicked"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
