<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
        x:Class="WTLauncher.App.Views.DirectoryManagementWindow"
        x:DataType="vm:DirectoryManagementViewModel"
        Title="地址管理"
        Width="820"
        Height="600"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Text="地址集中管理"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 Margin="0,4,0,12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="列出每个 directory 的引用次数 — 双击改地址(可浏览),自动同步所有引用 entry。&#x0a;合并两个地址: 失效方 entry.directory 全部改成保留方。"/>
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="0,0,0,8">
        <Button Content="编辑/重命名"
                Classes="secondary"
                MinWidth="90"
                IsEnabled="{Binding HasSelectedDirectory}"
                Click="OnRenameClicked"
                automation:AutomationProperties.Name="编辑或重选地址引用"/>
        <Button Content="合并到..."
                Classes="secondary"
                MinWidth="90"
                IsEnabled="{Binding HasSelectedDirectory}"
                Click="OnMergeClicked"
                automation:AutomationProperties.Name="合并到另一个地址"/>
        <Button Content="删除"
                Classes="secondary"
                MinWidth="90"
                IsEnabled="{Binding HasSelectedDirectory}"
                Command="{Binding DeleteDirectoryCommand}"
                automation:AutomationProperties.Name="删除地址引用"/>
        <TextBlock Margin="12,6,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   automation:AutomationProperties.Name="地址管理状态"/>
      </StackPanel>
      <Border Grid.Row="3"
              BorderThickness="1"
              CornerRadius="10"
              BorderBrush="{StaticResource CardBorderBrush}"
              Padding="8">
        <Grid>
          <ListBox Classes="management-list"
                   ItemsSource="{Binding DirectoryRows}"
                   SelectedItem="{Binding SelectedDirectoryRow, Mode=TwoWay}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:DirectoryRow">
                <Border Classes="management-row" DoubleTapped="OnRowDoubleTapped">
                  <Grid ColumnDefinitions="*,8,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Classes="mono-directory" Text="{Binding Directory}"/>
                      <ItemsControl ItemsSource="{Binding ReferencingEntryNames}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Classes="muted-detail" Text="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center">
                      <Run Text="引用 "/><Run Text="{Binding ReferenceCount}"/>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock IsVisible="{Binding HasNoDirectoryRows}"
                     Margin="8,12"
                     Text="(无 directory — 还没有任何启动按钮)"
                     Foreground="{StaticResource TextMutedBrush}"
                     automation:AutomationProperties.Name="无地址引用，还没有任何启动按钮"/>
        </Grid>
      </Border>
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Content="关闭"
                Classes="primary"
                MinWidth="110"
                Click="OnCloseClicked"
                automation:AutomationProperties.Name="关闭地址管理窗口"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
