<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
        x:Class="WTLauncher.App.Views.DirectoryManagementWindow"
        x:DataType="vm:DirectoryManagementViewModel"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="600"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Text="{Binding Heading}"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 Margin="0,4,0,12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="{Binding Description}"/>
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}"
                  Margin="0,0,0,8">
        <Button Content="{Binding EditRenameLabel}"
                Classes="secondary"
                MinWidth="90"
                IsEnabled="{Binding HasSelectedDirectory}"
                Click="OnRenameClicked"
                automation:AutomationProperties.Name="{Binding EditRenameAutomation}"/>
        <Button Content="{Binding MergeLabel}"
                Classes="secondary"
                MinWidth="90"
                IsEnabled="{Binding HasSelectedDirectory}"
                Click="OnMergeClicked"
                automation:AutomationProperties.Name="{Binding MergeAutomation}"/>
        <Button Content="{Binding DeleteLabel}"
                Classes="secondary"
                MinWidth="90"
                IsEnabled="{Binding HasSelectedDirectory}"
                Command="{Binding DeleteDirectoryCommand}"
                automation:AutomationProperties.Name="{Binding DeleteAutomation}"/>
        <TextBlock Margin="12,6,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   automation:AutomationProperties.Name="{Binding StatusAutomation}"/>
      </StackPanel>
      <Border Grid.Row="3"
              BorderThickness="1"
              CornerRadius="{StaticResource ControlCornerRadius}"
              BorderBrush="{StaticResource CardBorderBrush}"
              Padding="8">
        <Grid>
          <ListBox Classes="management-list"
                   ItemsSource="{Binding DirectoryRows}"
                   SelectedItem="{Binding SelectedDirectoryRow, Mode=TwoWay}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:DirectoryRow">
                <Border Classes="management-row" DoubleTapped="OnRowDoubleTapped">
                  <Grid ColumnDefinitions="*,8,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Classes="mono-directory" Text="{Binding Directory}"/>
                      <ItemsControl ItemsSource="{Binding ReferencingEntryNames}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Classes="muted-detail" Text="{Binding}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center">
                      <Run Text="{Binding $parent[Window].((vm:DirectoryManagementViewModel)DataContext).ReferencePrefix}"/><Run Text="{Binding ReferenceCount}"/>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock IsVisible="{Binding HasNoDirectoryRows}"
                     Margin="8,12"
                     Text="{Binding EmptyLabel}"
                     Foreground="{StaticResource TextMutedBrush}"
                     automation:AutomationProperties.Name="{Binding EmptyAutomation}"/>
        </Grid>
      </Border>
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Content="{Binding CloseLabel}"
                Classes="accent"
                MinWidth="110"
                Click="OnCloseClicked"
                automation:AutomationProperties.Name="{Binding CloseAutomation}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
