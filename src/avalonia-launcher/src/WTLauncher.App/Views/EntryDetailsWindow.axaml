<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        x:Class="WTLauncher.App.Views.EntryDetailsWindow"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <ScrollViewer>
      <StackPanel Spacing="{x:Static core:LauncherDesignTokens.DialogFooterSpacing}">
        <TextBlock x:Name="TitleText"
                   Classes="dialog-title"/>
        <TextBlock x:Name="IdLabel"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBox x:Name="IdBox"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="{StaticResource FontSizeBody}"
                 Padding="10,8"/>
        <TextBlock x:Name="PresetHintText"
                   IsVisible="False"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <TextBlock x:Name="NameLabel"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBox x:Name="NameBox"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="{StaticResource FontSizeBody}"
                 Padding="10,8"/>
        <TextBlock x:Name="DirectoryLabel"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="DirectoryBox"
                   FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                   FontSize="{StaticResource FontSizeBody}"
                   Padding="10,8"/>
          <Button x:Name="BrowseDirectoryButton"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Click="OnBrowseDirectoryClicked"/>
        </Grid>
        <TextBlock x:Name="CommandLabel"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBox x:Name="CommandBox"
                 FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                 FontSize="{StaticResource FontSizeBody}"
                 Padding="10,8"
                 MaxLength="4096"/>
        <TextBlock x:Name="TemplateSubtleText"
                   IsVisible="False"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <TextBlock x:Name="TemplatePreview"
                   IsVisible="False"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="ConfirmNote"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <CheckBox x:Name="SelectedBox"
                  Margin="0,8,0,0"/>
        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource DestructiveBrush}"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                    Margin="{StaticResource DialogFooterMargin}">
          <Button x:Name="CancelButton"
                  Classes="secondary"
                  MinWidth="96"
                  IsCancel="True"
                  Click="OnCancelClicked"/>
          <Button x:Name="SaveButton"
                  Classes="primary"
                  MinWidth="96"
                  Click="OnSaveClicked"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
