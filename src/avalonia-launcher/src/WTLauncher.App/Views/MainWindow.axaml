<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WTLauncher.App.Views"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
        x:Class="WTLauncher.App.Views.MainWindow"
        Title="WT Launcher"
        Width="{StaticResource WindowDefaultWidth}"
        Height="{StaticResource WindowDefaultHeight}"
        MinWidth="{StaticResource WindowMinWidth}"
        MinHeight="{StaticResource WindowMinHeight}"
        Background="{StaticResource BackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="{StaticResource CardBoxShadow}"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- P2: Disable transitions during drag to avoid layout thrashing -->
    <Style Selector="ItemsControl.suppress-drag-transitions Border.card">
      <Setter Property="Transitions">
        <Transitions/>
      </Setter>
    </Style>
    <!-- L41: Compact/micro spacing snapped to the 8/13/21 DESIGN.md rhythm.
         12→13, 10→8 (nearest Fibonacci-aligned value), 11→13. -->
    <Style Selector="Border.card.compact">
      <Setter Property="Padding" Value="13"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="Border.card.micro">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="Border.card.detail-row">
      <!-- Details list should feel closer to Windows Explorer: compact, column-aligned, flat rows. -->
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector="Border.card.detail-row:pointerover">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.card.detail-row.selected">
      <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Border.card.detail-row.selected:pointerover">
      <Setter Property="Background" Value="{StaticResource SelectionHoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.card.keyboard-focused">
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.detail-header">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBlock.detail-header-text">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Border.card.name-tile">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector="Border.card.name-tile:pointerover">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.card.name-tile.selected">
      <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.name-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.card.name-tile Border.entry-drag-handle">
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
    </Style>
    <Style Selector="ListBox.details-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.card.drag-target">
      <Setter Property="BorderBrush" Value="{StaticResource DragHighlightBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.card.drag-source">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Border.drag-insert">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="{StaticResource DragHighlightBrush}"/>
      <Setter Property="Opacity" Value="0.9"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.card.detail-row Button.primary">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.card.detail-row Button.more">
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.card.detail-row Border.entry-drag-handle">
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New, monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Grid.entry-header">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Grid.entry-actions">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="Grid.entry-footer">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-actions">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-footer">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-actions">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-footer">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Button.primary">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.card.micro Button.primary">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.more">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="40"/>
    </Style>
    <Style Selector="Border.card.compact Button.more">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <!-- L39: Minimum 32px height for reasonable touch/mouse hit target even at micro density -->
    <Style Selector="Border.card.micro Button.more">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.entry-drag-handle">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.card.compact Border.entry-drag-handle">
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
    </Style>
    <Style Selector="Border.card.micro Border.entry-drag-handle">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{StaticResource SecondaryButtonBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource SecondaryButtonForegroundBrush}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.control-box">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.control-box-label">
      <Setter Property="Foreground" Value="{StaticResource ControlBoxLabelBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="WT Launcher"/>
        <TextBlock Classes="muted"
                   Text="绿色便携启动器 · 搜索、勾选、一键启动"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Top">
        <Border Background="{StaticResource BadgeSuccessBackgroundBrush}"
                CornerRadius="14"
                Padding="12,8"
                VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource BadgeSuccessForegroundBrush}">
            <Run Text="已勾选 "/>
            <Run Text="{Binding SelectedCount}"/>
            <Run Text=" 项"/>
          </TextBlock>
        </Border>
        <ToggleSwitch IsChecked="{Binding RequireConfirmationForLaunches, Mode=TwoWay}"
                      Content="{Binding LaunchConfirmationToggleText}"
                      ToolTip.Tip="{Binding LaunchConfirmationToggleTip}"
                      VerticalAlignment="Center"/>
        <Button Classes="secondary"
                Content="全选可见"
                Command="{Binding SelectVisibleCommand}"/>
        <Button Classes="secondary"
                Content="清空"
                Command="{Binding ClearSelectionCommand}"/>
        <Button Classes="primary"
                Content="一键启动已勾选"
                Command="{Binding LaunchSelectedCommand}"/>
        <Button Classes="secondary"
                Content="重新加载"
                Command="{Binding RefreshCommand}"/>
      </StackPanel>
      <TextBlock Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding ConfigPathDisplay}"/>
      <!-- L40: Four-box row weights: Search (1.8* — needs room for typeahead text),
           Sort (1* — compact dropdown), View (1* — compact dropdown),
           PresetGroup (2.8* — widest: ComboBox + 3 buttons + label). -->
      <Grid x:Name="ControlBoxesGrid"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ColumnDefinitions="1.8*,1*,1*,2.8*"
            ColumnSpacing="12"
            Margin="0,12,0,0">
        <Border Classes="control-box">
          <StackPanel>
            <TextBlock Classes="control-box-label"
                       Text="搜索"/>
            <AutoCompleteBox x:Name="SearchTextBox"
                             automation:AutomationProperties.Name="搜索"
                             PlaceholderText="搜索名称、目录或命令"
                             Text="{Binding FilterText, Mode=TwoWay}"
                             ItemsSource="{Binding SearchHistoryItems}"
                             MinimumPrefixLength="1"
                             MinimumPopulateDelay="0:0:0.150"
                             IsTextCompletionEnabled="False"
                             FontSize="16"
                             Padding="12,8"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Classes="control-box">
          <StackPanel>
            <TextBlock Classes="control-box-label"
                       Text="排序"/>
            <!-- P3: Removed DropDownClosed — OnSelectedSortModeChanged already calls ApplyFilter -->
            <ComboBox ItemsSource="{Binding SortModes}"
                      SelectedItem="{Binding SelectedSortMode, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2"
                Classes="control-box">
          <StackPanel>
            <TextBlock Classes="control-box-label"
                       Text="视图"/>
            <!-- P3: Removed DropDownClosed — OnSelectedDisplayModeChanged already calls Refresh+save -->
            <ComboBox x:Name="DisplayModeComboBox"
                      ItemsSource="{Binding DisplayModes}"
                      SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3"
                Classes="control-box">
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto,Auto,Auto"
                ColumnSpacing="8">
            <TextBlock Grid.ColumnSpan="4"
                       Classes="control-box-label"
                       Text="启动组"/>
            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      PlaceholderText="选择启动组"/>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Classes="secondary"
                    Content="{Binding ApplyPresetButtonText}"
                    Command="{Binding ApplyPresetCommand}"/>
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Classes="secondary"
                    Content="预演"
                    Command="{Binding PreviewSelectedPresetCommand}"/>
            <Button Grid.Row="1"
                    Grid.Column="3"
                    Classes="primary"
                    Content="启动"
                    AutomationProperties.Name="启动"
                    Command="{Binding LaunchSelectedPresetCommand}"/>
          </Grid>
        </Border>
      </Grid>
      <StackPanel Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Orientation="Horizontal"
                  Spacing="10"
                  Margin="0,10,0,0">
        <Button Classes="primary"
                Content="新增按钮"
                Command="{Binding AddEntryCommand}"/>
        <Button Classes="secondary"
                Content="🔍 发现"
                Command="{Binding DiscoverAgentsCommand}"/>
        <Button Classes="secondary"
                Content="保存为新启动组"
                Command="{Binding SaveSelectionAsPresetCommand}"/>
        <Button Classes="secondary"
                Content="更新当前启动组"
                Command="{Binding UpdateSelectedPresetCommand}"/>
        <Button Classes="secondary"
                Content="删除当前启动组"
                Command="{Binding DeleteSelectedPresetCommand}"/>
        <Border Background="{StaticResource BadgeInfoBackgroundBrush}"
                CornerRadius="14"
                Padding="12,7"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource BadgeInfoForegroundBrush}">
            <Run Text="{Binding VisibleCount}"/>
            <Run Text=" / "/>
            <Run Text="{Binding TotalCount}"/>
          </TextBlock>
        </Border>
      </StackPanel>
      <TextBlock Grid.Row="4"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding PresetSelectionStatusText}"/>
    </Grid>

    <Grid Grid.Row="1"
          Margin="0,16,0,14">
      <ScrollViewer x:Name="CardsScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding IsCardsViewMode}">
        <Grid>
        <ItemsControl x:Name="CardsEntriesItemsControl"
                      ItemsSource="{Binding VisibleEntries}"
                      IsVisible="{Binding IsCardsViewMode}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <views:FastWrapPanel ItemSpacing="{x:Static core:LauncherDesignTokens.SpacingSmall}" LineSpacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card"
                      Classes.selected="{Binding IsSelected}"
                      Classes.drag-target="{Binding IsDragPreviewTarget}"
                      Classes.drag-source="{Binding IsDragPreviewSource}"
                      Classes.compact="{Binding IsCompactLayout}"
                      Classes.micro="{Binding IsMicroLayout}"
                      Classes.keyboard-focused="{Binding IsKeyboardFocused}"
                      Width="{Binding CardWidth}"
                      Height="{Binding CardHeight}"
                      ClipToBounds="True">
                <!-- L51: Keyboard accelerators for context menu discoverability -->
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="启动"
                              AutomationProperties.Name="启动"
                              Command="{Binding LaunchCommand}"/>
                    <MenuItem Header="预演"
                              AutomationProperties.Name="预演"
                              Command="{Binding DryRunCommand}"/>
                    <MenuItem Header="上移排序"
                              AutomationProperties.Name="上移排序"
                              InputGesture="Ctrl+Up"
                              Command="{Binding MoveUpCommand}"/>
                    <MenuItem Header="下移排序"
                              AutomationProperties.Name="下移排序"
                              InputGesture="Ctrl+Down"
                              Command="{Binding MoveDownCommand}"/>
                    <MenuItem Header="复制"
                              AutomationProperties.Name="复制"
                              InputGesture="Ctrl+D"
                              Command="{Binding CloneCommand}"/>
                    <MenuItem Header="编辑"
                              AutomationProperties.Name="编辑"
                              InputGesture="F2"
                              Command="{Binding EditCommand}"/>
                    <MenuItem Header="删除"
                              AutomationProperties.Name="删除"
                              InputGesture="Delete"
                              Command="{Binding DeleteCommand}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                  <Border Grid.RowSpan="4"
                          Classes="drag-insert"
                          Width="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertBefore}"/>
                  <Border Grid.RowSpan="4"
                          Classes="drag-insert"
                          Width="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertAfter}"/>
                  <Grid Classes="entry-header"
                        ColumnDefinitions="Auto,Auto,*">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Width="{StaticResource BrandBadgeSize}"
                            Height="{StaticResource BrandBadgeSize}"
                            CornerRadius="{StaticResource BrandBadgeCornerRadius}"
                            Background="{Binding BrandColorHex}"
                            Margin="8,0,0,0"
                            IsVisible="{Binding HasBrand}"
                            VerticalAlignment="Center">
                      <TextBlock Foreground="{StaticResource BrandBadgeForegroundBrush}"
                                 FontSize="11"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="{Binding BrandGlyph}"/>
                    </Border>
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               Classes="card-title"
                               FontSize="{Binding TitleFontSize}"
                               VerticalAlignment="Center"
                               Text="{Binding Name}"/>
                  </Grid>
                  <StackPanel Grid.Row="1"
                              ClipToBounds="True">
                    <TextBlock Classes="mono entry-dir"
                               IsVisible="{Binding ShowDirectory}"
                               MaxLines="1"
                               TextTrimming="PathSegmentEllipsis"
                               Text="{Binding Directory}"/>
                    <TextBlock Classes="mono entry-cmd"
                               IsVisible="{Binding ShowCommand}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Command}"/>
                  </StackPanel>
                  <Grid Grid.Row="2"
                        Classes="entry-actions"
                        ColumnDefinitions="*,Auto">
                    <Button Classes="primary"
                            Content="启动"
                            AutomationProperties.Name="启动"
                            Command="{Binding LaunchCommand}"/>
                    <Button Grid.Column="1"
                            Classes="secondary more"
                            Content="⋯"
                            Margin="8,0,0,0"
                            ToolTip.Tip="更多操作"
                            AutomationProperties.Name="更多操作"
                            Click="OnEntryMoreClicked"/>
                  </Grid>
                  <Grid Grid.Row="3"
                        Classes="entry-footer">
                    <Border Classes="entry-drag-handle"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="拖拽排序"
                            AutomationProperties.Name="拖拽排序"
                            PointerPressed="OnEntryDragPointerPressed">
                      <TextBlock Text="≡"
                                 Foreground="{StaticResource DragHandleTextBrush}"
                                 FontSize="12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- L47: Intentional z-order overlay — empty-state TextBlock and ItemsControl
             are siblings in a single-cell Grid. IsVisible binding ensures only one is
             visible at any time, so there is no visual overlap during normal use. -->
        <TextBlock x:Name="EmptyStateCardsText"
                   AutomationProperties.Name="无可见按钮"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="{x:Static vm:MainWindowViewModel.EmptyStateText}"
                   IsVisible="{Binding IsVisibleEmpty}"/>
      </Grid>
      </ScrollViewer>

      <Grid IsVisible="{Binding IsDetailedListMode}">
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource CardBorderRadius}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="detail-header"
                    CornerRadius="{StaticResource CardBorderRadius}"
                    IsVisible="{Binding !IsVisibleEmpty}">
              <Grid ColumnSpacing="12"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="{StaticResource DetailsNameColumnWidth}"/>
                  <ColumnDefinition Width="{StaticResource DetailsDirectoryColumnWidth}"/>
                  <ColumnDefinition Width="{StaticResource DetailsCommandColumnWidth}"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- L48: Decorative checkbox for visual column alignment only.
                     Not interactive — blocked from hit-testing and focus to avoid
                     confusing screen readers and keyboard navigation. -->
                <CheckBox IsEnabled="False"
                          Opacity="0"
                          IsHitTestVisible="False"
                          Focusable="False"/>
                <TextBlock Grid.Column="1"
                           Classes="detail-header-text"
                           Text="名称"/>
                <TextBlock Grid.Column="2"
                           Classes="detail-header-text"
                           Text="目录"/>
                <TextBlock Grid.Column="3"
                           Classes="detail-header-text"
                           Text="命令"/>
              </Grid>
            </Border>

            <ListBox x:Name="DetailsEntriesItemsControl"
                     Grid.Row="1"
                     Classes="details-list"
                     ItemsSource="{Binding VisibleEntries}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card detail-row"
                          Classes.drag-target="{Binding IsDragPreviewTarget}"
                          Classes.drag-source="{Binding IsDragPreviewSource}"
                          Classes.selected="{Binding IsSelected}"
                          Classes.keyboard-focused="{Binding IsKeyboardFocused}"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          DoubleTapped="OnEntryRowDoubleTapped">
                    <!-- L51: Keyboard accelerators for context menu discoverability -->
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="启动"
                                  AutomationProperties.Name="启动"
                                  Command="{Binding LaunchCommand}"/>
                        <MenuItem Header="预演"
                                  AutomationProperties.Name="预演"
                                  Command="{Binding DryRunCommand}"/>
                        <MenuItem Header="上移排序"
                                  AutomationProperties.Name="上移排序"
                                  InputGesture="Ctrl+Up"
                                  Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="下移排序"
                                  AutomationProperties.Name="下移排序"
                                  InputGesture="Ctrl+Down"
                                  Command="{Binding MoveDownCommand}"/>
                        <MenuItem Header="复制"
                                  AutomationProperties.Name="复制"
                                  InputGesture="Ctrl+D"
                                  Command="{Binding CloneCommand}"/>
                        <MenuItem Header="编辑"
                                  AutomationProperties.Name="编辑"
                                  InputGesture="F2"
                                  Command="{Binding EditCommand}"/>
                        <MenuItem Header="删除"
                                  AutomationProperties.Name="删除"
                                  InputGesture="Delete"
                                  Command="{Binding DeleteCommand}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnSpacing="12"
                          VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource DetailsNameColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource DetailsDirectoryColumnWidth}"/>
                        <ColumnDefinition Width="{StaticResource DetailsCommandColumnWidth}"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- insertion preview -->
                      <Border Grid.ColumnSpan="5"
                              Classes="drag-insert"
                              ZIndex="10"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"
                              IsVisible="{Binding IsDragInsertBefore}"/>
                      <Border Grid.ColumnSpan="5"
                              Classes="drag-insert"
                              ZIndex="10"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              IsVisible="{Binding IsDragInsertAfter}"/>

                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                VerticalAlignment="Center"/>

                      <TextBlock Grid.Column="1"
                                 Classes="card-title"
                                 FontSize="{Binding TitleFontSize}"
                                 MaxLines="1"
                                 ToolTip.Tip="{Binding Name}"
                                 Text="{Binding Name}"/>

                      <TextBlock Grid.Column="2"
                                 Classes="mono"
                                 MaxLines="1"
                                 TextTrimming="PathSegmentEllipsis"
                                 ToolTip.Tip="{Binding Directory}"
                                 Text="{Binding Directory}"/>

                      <TextBlock Grid.Column="3"
                                 Classes="mono"
                                 MaxLines="1"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Command}"
                                 Text="{Binding Command}"/>

                      <StackPanel Grid.Column="4"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button Classes="primary"
                                Content="启动"
                                AutomationProperties.Name="启动"
                                Command="{Binding LaunchCommand}"/>
                        <Button Classes="secondary more"
                                Content="⋯"
                                ToolTip.Tip="更多操作"
                                AutomationProperties.Name="更多操作"
                                Click="OnEntryMoreClicked"/>
                        <Border Classes="entry-drag-handle"
                                Cursor="Hand"
                                ToolTip.Tip="拖拽排序"
                                AutomationProperties.Name="拖拽排序"
                                PointerPressed="OnEntryDragPointerPressed">
                          <TextBlock Text="≡"
                                     Foreground="{StaticResource DragHandleTextBrush}"
                                     FontSize="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      <TextBlock x:Name="EmptyStateDetailsText"
                 AutomationProperties.Name="无可见按钮"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="{x:Static vm:MainWindowViewModel.EmptyStateText}"
                 IsVisible="{Binding IsVisibleEmpty}"/>
      </Grid>

      <ScrollViewer x:Name="NamesScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding IsNamesViewMode}">
        <Grid>
        <ItemsControl x:Name="NamesEntriesItemsControl"
                      ItemsSource="{Binding VisibleEntries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <views:FastWrapPanel ItemSpacing="{x:Static core:LauncherDesignTokens.NameTileGap}" LineSpacing="{x:Static core:LauncherDesignTokens.NameTileRowGap}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card name-tile"
                      Classes.drag-target="{Binding IsDragPreviewTarget}"
                      Classes.drag-source="{Binding IsDragPreviewSource}"
                      Classes.selected="{Binding IsSelected}"
                      Classes.keyboard-focused="{Binding IsKeyboardFocused}"
                      Width="{Binding NameTileWidth}"
                      Height="{Binding NameTileHeight}"
                      ClipToBounds="True"
                      DoubleTapped="OnEntryRowDoubleTapped">
                <!-- L51: Keyboard accelerators for context menu discoverability -->
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="启动"
                              AutomationProperties.Name="启动"
                              Command="{Binding LaunchCommand}"/>
                    <MenuItem Header="预演"
                              AutomationProperties.Name="预演"
                              Command="{Binding DryRunCommand}"/>
                    <MenuItem Header="上移排序"
                              AutomationProperties.Name="上移排序"
                              InputGesture="Ctrl+Up"
                              Command="{Binding MoveUpCommand}"/>
                    <MenuItem Header="下移排序"
                              AutomationProperties.Name="下移排序"
                              InputGesture="Ctrl+Down"
                              Command="{Binding MoveDownCommand}"/>
                    <MenuItem Header="复制"
                              AutomationProperties.Name="复制"
                              InputGesture="Ctrl+D"
                              Command="{Binding CloneCommand}"/>
                    <MenuItem Header="编辑"
                              AutomationProperties.Name="编辑"
                              InputGesture="F2"
                              Command="{Binding EditCommand}"/>
                    <MenuItem Header="删除"
                              AutomationProperties.Name="删除"
                              InputGesture="Delete"
                              Command="{Binding DeleteCommand}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="6"
                      VerticalAlignment="Center">
                  <Border Grid.ColumnSpan="3"
                          Classes="drag-insert"
                          ZIndex="10"
                          Width="3"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertBefore}"/>
                  <Border Grid.ColumnSpan="3"
                          Classes="drag-insert"
                          ZIndex="10"
                          Width="3"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertAfter}"/>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Classes="name-title"
                             ToolTip.Tip="{Binding Name}"
                             MaxLines="1"
                             VerticalAlignment="Center"
                             Text="{Binding Name}"/>
                  <Border Grid.Column="2"
                          Classes="entry-drag-handle"
                          Cursor="Hand"
                          ToolTip.Tip="拖拽排序"
                          AutomationProperties.Name="拖拽排序"
                          PointerPressed="OnEntryDragPointerPressed">
                    <TextBlock Text="≡"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyStateNamesText"
                   AutomationProperties.Name="无可见按钮"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="{x:Static vm:MainWindowViewModel.EmptyStateText}"
                   IsVisible="{Binding IsVisibleEmpty}"/>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            Padding="16">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding StatusText}"
                   automation:AutomationProperties.Name="状态信息"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Classes="mono"
                   Text="{Binding DryRunText}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
