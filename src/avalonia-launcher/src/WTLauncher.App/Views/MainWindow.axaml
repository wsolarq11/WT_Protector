<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WTLauncher.App.Views"
        xmlns:controls="clr-namespace:WTLauncher.App.Views.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
        x:Class="WTLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WT Launcher"
        Icon="avares://WTLauncher.App/Assets/app.ico"
        Width="{StaticResource WindowDefaultWidth}"
        Height="{StaticResource WindowDefaultHeight}"
        MinWidth="{StaticResource WindowMinWidth}"
        MinHeight="{StaticResource WindowMinHeight}"
        Background="{StaticResource BackgroundBrush}">
  <Window.Resources>
    <!-- Lucide icon geometries (ISC license, https://lucide.dev) -->
    <StreamGeometry x:Key="IconGripVertical">M 9,4 A 1,1 0 1,1 9,6 A 1,1 0 1,1 9,4 M 9,11 A 1,1 0 1,1 9,13 A 1,1 0 1,1 9,11 M 9,18 A 1,1 0 1,1 9,20 A 1,1 0 1,1 9,18 M 15,4 A 1,1 0 1,1 15,6 A 1,1 0 1,1 15,4 M 15,11 A 1,1 0 1,1 15,13 A 1,1 0 1,1 15,11 M 15,18 A 1,1 0 1,1 15,20 A 1,1 0 1,1 15,18</StreamGeometry>
    <StreamGeometry x:Key="IconMoreVertical">M 12,4 A 1,1 0 1,1 12,6 A 1,1 0 1,1 12,4 M 12,11 A 1,1 0 1,1 12,13 A 1,1 0 1,1 12,11 M 12,18 A 1,1 0 1,1 12,20 A 1,1 0 1,1 12,18</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M 6 9 L 12 15 L 18 9</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M 9 6 L 15 12 L 9 18</StreamGeometry>
    <StreamGeometry x:Key="IconStatusCheck">M 20 6 L 9 17 L 5 12</StreamGeometry>
    <StreamGeometry x:Key="IconStatusX">M 18 6 L 6 18 M 6 6 L 18 18</StreamGeometry>
    <StreamGeometry x:Key="IconStatusCircle">M 12 2 A 10 10 0 1 1 12 22 A 10 10 0 1 1 12 2</StreamGeometry>
    <StreamGeometry x:Key="IconStatusAlert">M 12 2 L 22 21 L 2 21 Z M 12 9 L 12 14 M 12 17 L 12 17.5</StreamGeometry>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.status-panel">
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.status-panel.status-success">
      <Setter Property="BorderBrush" Value="{StaticResource BadgeSuccessForegroundBrush}"/>
    </Style>
    <Style Selector="Border.status-panel.status-warning">
      <Setter Property="BorderBrush" Value="{StaticResource BadgeInfoForegroundBrush}"/>
    </Style>
    <Style Selector="Border.status-panel.status-error">
      <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="{StaticResource CardBoxShadow}"/>
      <Setter Property="RenderTransform" Value="translateY(0)"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card.stale">
      <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
      <Setter Property="BoxShadow" Value="{StaticResource NoBoxShadow}"/>
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px)"/>
    </Style>
    <!-- Suppress hover lift during drag preview to avoid visual conflict -->
    <Style Selector="Border.card.drag-source:pointerover">
      <Setter Property="RenderTransform" Value="translateY(0)"/>
    </Style>
    <!-- R2: Disable transitions when user prefers reduced motion -->
    <Style Selector=".reduced-motion Border.card">
      <Setter Property="Transitions">
        <Transitions/>
      </Setter>
    </Style>
    <!-- P2: Disable transitions during drag to avoid layout thrashing -->
    <Style Selector="ItemsControl.suppress-drag-transitions Border.card">
      <Setter Property="Transitions">
        <Transitions/>
      </Setter>
    </Style>
    <!-- L41: Compact/micro spacing snapped to the 8/13/21 DESIGN.md rhythm.
         12→13, 10→8 (nearest Fibonacci-aligned value), 11→13. -->
    <Style Selector="Border.card.compact">
      <Setter Property="Padding" Value="13"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="Border.card.micro">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="Border.card.detail-row">
      <!-- Details list should feel closer to Windows Explorer: compact, column-aligned, flat rows. -->
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BoxShadow" Value="{StaticResource NoBoxShadow}"/>
    </Style>
    <Style Selector="Border.card.detail-row:pointerover">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.card.detail-row.selected">
      <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="Border.card.detail-row.selected:pointerover">
      <Setter Property="Background" Value="{StaticResource SelectionHoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.card.selected">
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.card.keyboard-focused">
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.detail-header">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBlock.detail-header-text">
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Border.card.name-tile">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="{StaticResource NoBoxShadow}"/>
    </Style>
    <Style Selector="Border.card.name-tile:pointerover">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.card.name-tile.selected">
      <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.name-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.card.name-tile Border.entry-drag-handle">
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
    </Style>
    <Style Selector="ListBox.details-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.card.drag-target">
      <Setter Property="BorderBrush" Value="{StaticResource DragHighlightBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.card.drag-source">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Border.drag-insert">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="{StaticResource DragHighlightBrush}"/>
      <Setter Property="Opacity" Value="0.9"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.card.detail-row Button.accent">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="{StaticResource CardBorderRadius}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    </Style>
    <Style Selector="Border.card.detail-row Button.more">
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="Border.card.detail-row Border.entry-drag-handle">
      <Setter Property="Padding" Value="6,0"/>
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New, monospace"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Grid.entry-header">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Grid.entry-actions">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-actions">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-actions">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Button.accent">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.card.micro Button.accent">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <!-- Ghost icon button: transparent until hover, neutral gray glyph -->
    <Style Selector="Button.more">
      <Setter Property="Theme" Value="{StaticResource BorderlessButton}"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.more:pointerover /template/ Path">
      <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <!-- Drag handle: ghost grip — transparent, light fill only on hover -->
    <Style Selector="Border.entry-drag-handle">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="Border.entry-drag-handle:pointerover">
      <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.control-box">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="BoxShadow" Value="{StaticResource ControlBoxShadow}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.control-box-label">
      <Setter Property="Foreground" Value="{StaticResource ControlBoxLabelBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Window.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <views:LauncherControlBar x:Name="ControlBar"/>

    <views:LauncherEntriesView x:Name="EntriesView" Grid.Row="1"/>

    <controls:StatusBar Grid.Row="2"/>
    </Grid>
  </Grid>
</Window>
