<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WTLauncher.App.Views.MainWindow"
        Title="WT Launcher"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="600"
        Background="#F8FAFC">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #120F172A"/>
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="WT Launcher"/>
        <TextBlock Classes="muted"
                   Text="绿色便携启动器 · 搜索、勾选、一键启动"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Top">
        <Border Background="#ECFDF5"
                CornerRadius="14"
                Padding="12,8"
                VerticalAlignment="Center">
          <TextBlock Foreground="#047857">
            <Run Text="已勾选 "/>
            <Run Text="{Binding SelectedCount}"/>
            <Run Text=" 项"/>
          </TextBlock>
        </Border>
        <Button Classes="secondary"
                Content="全选可见"
                Command="{Binding SelectVisibleCommand}"/>
        <Button Classes="secondary"
                Content="清空"
                Command="{Binding ClearSelectionCommand}"/>
        <Button Classes="primary"
                Content="一键启动已勾选"
                Command="{Binding LaunchSelectedCommand}"/>
        <Button Classes="secondary"
                Content="重新加载"
                Command="{Binding RefreshCommand}"/>
      </StackPanel>
      <TextBlock Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding ConfigPathDisplay}"/>
      <Grid Grid.Row="2"
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,Auto,Auto,Auto"
            Margin="0,12,0,0">
        <TextBox PlaceholderText="搜索名称、目录或命令"
                 Text="{Binding FilterText, Mode=TwoWay}"
                 FontSize="16"
                 Padding="12,8"/>
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Presets}"
                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                  Width="220"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  PlaceholderText="选择启动组"/>
        <Button Grid.Column="2"
                Classes="secondary"
                Content="应用启动组"
                Command="{Binding ApplyPresetCommand}"
                Margin="10,0,0,0"/>
        <Border Grid.Column="3"
                Background="#E0F2FE"
                CornerRadius="14"
                Padding="12,7"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Foreground="#0369A1">
            <Run Text="{Binding VisibleCount}"/>
            <Run Text=" / "/>
            <Run Text="{Binding TotalCount}"/>
          </TextBlock>
        </Border>
      </Grid>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,14">
      <ItemsControl ItemsSource="{Binding VisibleEntries}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Width="300" MinHeight="164">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Margin="8,0,0,0"
                             Classes="card-title"
                             Text="{Binding Name}"/>
                  <Border Grid.Column="2"
                          Background="#FEF3C7"
                          CornerRadius="999"
                          Padding="8,3"
                          IsVisible="{Binding IsDangerous}">
                    <TextBlock Text="需确认"
                               FontSize="11"
                               Foreground="#92400E"
                               FontWeight="SemiBold"/>
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Classes="mono"
                           Text="{Binding Directory}"/>
                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           Classes="mono"
                           Text="{Binding Command}"/>
                <TextBlock Grid.Row="3"
                           Margin="0,10,0,10"
                           Classes="muted"
                           Text="{Binding ConfirmationLabel}"/>
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="10">
                  <Button Classes="primary"
                          Content="启动"
                          Command="{Binding LaunchCommand}"/>
                  <Button Classes="secondary"
                          Content="预演"
                          Command="{Binding DryRunCommand}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="White"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="16">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Classes="mono"
                   Text="{Binding DryRunText}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
