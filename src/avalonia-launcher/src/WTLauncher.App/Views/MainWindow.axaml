<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WTLauncher.App.Views.MainWindow"
        Title="WT Launcher"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="600"
        Background="#F8FAFC"
        DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="13"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #120F172A"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card.compact">
      <Setter Property="Padding" Value="12"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.card.micro">
      <Setter Property="Padding" Value="10"/>
      <Setter Property="CornerRadius" Value="11"/>
    </Style>
    <Style Selector="Border.card.detail-row">
      <!-- Details list should feel closer to Windows Explorer: compact, column-aligned, flat rows. -->
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector="Border.card.detail-row:pointerover">
      <Setter Property="Background" Value="#F1F5F9"/>
    </Style>
    <Style Selector="Border.card.detail-row.selected">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="BorderBrush" Value="#C7D2FE"/>
    </Style>
    <Style Selector="Border.card.detail-row.selected:pointerover">
      <Setter Property="Background" Value="#E0E7FF"/>
    </Style>
    <Style Selector="Border.detail-header">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBlock.detail-header-text">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#64748B"/>
    </Style>
    <Style Selector="Border.card.name-tile">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector="Border.card.name-tile:pointerover">
      <Setter Property="Background" Value="#F1F5F9"/>
    </Style>
    <Style Selector="Border.card.name-tile.selected">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="BorderBrush" Value="#C7D2FE"/>
    </Style>
    <Style Selector="TextBlock.name-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.card.name-tile Border.entry-drag-handle">
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style Selector="ListBox.details-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.details-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.card.drag-target">
      <Setter Property="BorderBrush" Value="#38BDF8"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.card.drag-source">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Border.drag-insert">
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="#38BDF8"/>
      <Setter Property="Opacity" Value="0.9"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.card.detail-row Button.primary">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.card.detail-row Button.more">
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.card.detail-row Border.entry-drag-handle">
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Grid.entry-header">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Grid.entry-actions">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="Grid.entry-footer">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-actions">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-footer">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-actions">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-footer">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Button.primary">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.card.micro Button.primary">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.more">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="40"/>
    </Style>
    <Style Selector="Border.card.compact Button.more">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.card.micro Button.more">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.entry-drag-handle">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.card.compact Border.entry-drag-handle">
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.card.micro Border.entry-drag-handle">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.control-box">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.control-box-label">
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="WT Launcher"/>
        <TextBlock Classes="muted"
                   Text="绿色便携启动器 · 搜索、勾选、一键启动"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Top">
        <Border Background="#ECFDF5"
                CornerRadius="14"
                Padding="12,8"
                VerticalAlignment="Center">
          <TextBlock Foreground="#047857">
            <Run Text="已勾选 "/>
            <Run Text="{Binding SelectedCount}"/>
            <Run Text=" 项"/>
          </TextBlock>
        </Border>
        <ToggleSwitch IsChecked="{Binding RequireConfirmationForLaunches, Mode=TwoWay}"
                      Content="{Binding LaunchConfirmationToggleText}"
                      ToolTip.Tip="{Binding LaunchConfirmationToggleTip}"
                      VerticalAlignment="Center"/>
        <Button Classes="secondary"
                Content="全选可见"
                Command="{Binding SelectVisibleCommand}"/>
        <Button Classes="secondary"
                Content="清空"
                Command="{Binding ClearSelectionCommand}"/>
        <Button Classes="primary"
                Content="一键启动已勾选"
                Command="{Binding LaunchSelectedCommand}"/>
        <Button Classes="secondary"
                Content="重新加载"
                Command="{Binding RefreshCommand}"/>
      </StackPanel>
      <TextBlock Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding ConfigPathDisplay}"/>
      <Grid x:Name="ControlBoxesGrid"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ColumnDefinitions="2.2*,1.1*,1.1*,2.2*"
            ColumnSpacing="12"
            Margin="0,12,0,0">
        <Border Classes="control-box">
          <StackPanel>
            <TextBlock Classes="control-box-label"
                       Text="搜索"/>
            <TextBox PlaceholderText="搜索名称、目录或命令"
                     Text="{Binding FilterText, Mode=TwoWay}"
                     FontSize="16"
                     Padding="12,8"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Classes="control-box">
          <StackPanel>
            <TextBlock Classes="control-box-label"
                       Text="排序"/>
            <ComboBox ItemsSource="{Binding SortModes}"
                      SelectedItem="{Binding SelectedSortMode, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2"
                Classes="control-box">
          <StackPanel>
            <TextBlock Classes="control-box-label"
                       Text="视图"/>
            <ComboBox ItemsSource="{Binding DisplayModes}"
                      SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3"
                Classes="control-box">
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
            <TextBlock Grid.ColumnSpan="3"
                       Classes="control-box-label"
                       Text="启动组"/>
            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      PlaceholderText="选择启动组"/>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Classes="secondary"
                    Content="{Binding ApplyPresetButtonText}"
                    Command="{Binding ApplyPresetCommand}"/>
            <Button Grid.Row="1"
                    Grid.Column="2"
                    Classes="primary"
                    Content="启动当前组"
                    Command="{Binding LaunchSelectedPresetCommand}"/>
          </Grid>
        </Border>
      </Grid>
      <StackPanel Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Orientation="Horizontal"
                  Spacing="10"
                  Margin="0,10,0,0">
        <Button Classes="primary"
                Content="新增按钮"
                Command="{Binding AddEntryCommand}"/>
        <Button Classes="secondary"
                Content="保存为新启动组"
                Command="{Binding SaveSelectionAsPresetCommand}"/>
        <Button Classes="secondary"
                Content="更新当前启动组"
                Command="{Binding UpdateSelectedPresetCommand}"/>
        <Button Classes="secondary"
                Content="删除当前启动组"
                Command="{Binding DeleteSelectedPresetCommand}"/>
        <Border Background="#E0F2FE"
                CornerRadius="14"
                Padding="12,7"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Foreground="#0369A1">
            <Run Text="{Binding VisibleCount}"/>
            <Run Text=" / "/>
            <Run Text="{Binding TotalCount}"/>
          </TextBlock>
        </Border>
      </StackPanel>
      <TextBlock Grid.Row="4"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding PresetSelectionStatusText}"/>
    </Grid>

    <Grid Grid.Row="1"
          Margin="0,16,0,14">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding IsCardsViewMode}">
        <Grid>
        <ItemsControl x:Name="CardsEntriesItemsControl"
                      ItemsSource="{Binding VisibleEntries}"
                      IsVisible="{Binding IsCardsViewMode}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card"
                      Classes.drag-target="{Binding IsDragPreviewTarget}"
                      Classes.drag-source="{Binding IsDragPreviewSource}"
                      Classes.compact="{Binding IsCompactLayout}"
                      Classes.micro="{Binding IsMicroLayout}"
                      Width="{Binding CardWidth}"
                      Height="{Binding CardHeight}"
                      ClipToBounds="True"
                      DragDrop.AllowDrop="True">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="启动"
                              Command="{Binding LaunchCommand}"/>
                    <MenuItem Header="预演"
                              Command="{Binding DryRunCommand}"/>
                    <MenuItem Header="上移排序"
                              Command="{Binding MoveUpCommand}"/>
                    <MenuItem Header="下移排序"
                              Command="{Binding MoveDownCommand}"/>
                    <MenuItem Header="编辑"
                              Command="{Binding EditCommand}"/>
                    <MenuItem Header="删除"
                              Command="{Binding DeleteCommand}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                  <Border Grid.RowSpan="4"
                          Classes="drag-insert"
                          Width="4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertBefore}"/>
                  <Border Grid.RowSpan="4"
                          Classes="drag-insert"
                          Width="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertAfter}"/>
                  <Grid Classes="entry-header"
                        ColumnDefinitions="Auto,*">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               Classes="card-title"
                               FontSize="{Binding TitleFontSize}"
                               VerticalAlignment="Center"
                               Text="{Binding Name}"/>
                  </Grid>
                  <StackPanel Grid.Row="1"
                              ClipToBounds="True">
                    <TextBlock Classes="mono entry-dir"
                               IsVisible="{Binding ShowDirectory}"
                               MaxLines="1"
                               TextTrimming="PathSegmentEllipsis"
                               Text="{Binding Directory}"/>
                    <TextBlock Classes="mono entry-cmd"
                               IsVisible="{Binding ShowCommand}"
                               MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Command}"/>
                  </StackPanel>
                  <Grid Grid.Row="2"
                        Classes="entry-actions"
                        ColumnDefinitions="*,Auto">
                    <Button Classes="primary"
                            Content="启动"
                            Command="{Binding LaunchCommand}"/>
                    <Button Grid.Column="1"
                            Classes="secondary more"
                            Content="⋯"
                            Margin="8,0,0,0"
                            ToolTip.Tip="更多操作"
                            AutomationProperties.Name="更多操作"
                            Click="OnEntryMoreClicked"/>
                  </Grid>
                  <Grid Grid.Row="3"
                        Classes="entry-footer">
                    <Border Classes="entry-drag-handle"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="拖拽排序"
                            AutomationProperties.Name="拖拽排序"
                            PointerPressed="OnEntryDragPointerPressed">
                      <TextBlock Text="拖拽"
                                 Foreground="#334155"
                                 FontSize="12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Grid>
      </ScrollViewer>

      <Grid IsVisible="{Binding IsDetailedListMode}">
        <Border Background="White"
                CornerRadius="13"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="detail-header"
                    CornerRadius="13 13 0 0">
              <Grid ColumnDefinitions="Auto,2*,2*,3*,Auto"
                    ColumnSpacing="12"
                    VerticalAlignment="Center">
                <!-- align with rows: checkbox + columns -->
                <CheckBox IsEnabled="False"
                          Opacity="0"/>
                <TextBlock Grid.Column="1"
                           Classes="detail-header-text"
                           Text="名称"/>
                <TextBlock Grid.Column="2"
                           Classes="detail-header-text"
                           Text="目录"/>
                <TextBlock Grid.Column="3"
                           Classes="detail-header-text"
                           Text="命令"/>
              </Grid>
            </Border>

            <ListBox x:Name="DetailsEntriesItemsControl"
                     Grid.Row="1"
                     Classes="details-list"
                     ItemsSource="{Binding VisibleEntries}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card detail-row"
                          Classes.drag-target="{Binding IsDragPreviewTarget}"
                          Classes.drag-source="{Binding IsDragPreviewSource}"
                          Classes.selected="{Binding IsSelected}"
                          ClipToBounds="True"
                          HorizontalAlignment="Stretch"
                          DoubleTapped="OnEntryRowDoubleTapped"
                          DragDrop.AllowDrop="True">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="启动"
                                  Command="{Binding LaunchCommand}"/>
                        <MenuItem Header="预演"
                                  Command="{Binding DryRunCommand}"/>
                        <MenuItem Header="上移排序"
                                  Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="下移排序"
                                  Command="{Binding MoveDownCommand}"/>
                        <MenuItem Header="编辑"
                                  Command="{Binding EditCommand}"/>
                        <MenuItem Header="删除"
                                  Command="{Binding DeleteCommand}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="Auto,2*,2*,3*,Auto"
                          ColumnSpacing="12"
                          VerticalAlignment="Center">
                      <!-- insertion preview -->
                      <Border Grid.ColumnSpan="5"
                              Classes="drag-insert"
                              ZIndex="10"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"
                              IsVisible="{Binding IsDragInsertBefore}"/>
                      <Border Grid.ColumnSpan="5"
                              Classes="drag-insert"
                              ZIndex="10"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              IsVisible="{Binding IsDragInsertAfter}"/>

                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                VerticalAlignment="Center"/>

                      <TextBlock Grid.Column="1"
                                 Classes="card-title"
                                 FontSize="{Binding TitleFontSize}"
                                 MaxLines="1"
                                 ToolTip.Tip="{Binding Name}"
                                 Text="{Binding Name}"/>

                      <TextBlock Grid.Column="2"
                                 Classes="mono"
                                 MaxLines="1"
                                 TextTrimming="PathSegmentEllipsis"
                                 ToolTip.Tip="{Binding Directory}"
                                 Text="{Binding Directory}"/>

                      <TextBlock Grid.Column="3"
                                 Classes="mono"
                                 MaxLines="1"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Command}"
                                 Text="{Binding Command}"/>

                      <StackPanel Grid.Column="4"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <Button Classes="primary"
                                Content="启动"
                                Command="{Binding LaunchCommand}"/>
                        <Button Classes="secondary more"
                                Content="⋯"
                                ToolTip.Tip="更多操作"
                                AutomationProperties.Name="更多操作"
                                Click="OnEntryMoreClicked"/>
                        <Border Classes="entry-drag-handle"
                                Cursor="Hand"
                                ToolTip.Tip="拖拽排序"
                                AutomationProperties.Name="拖拽排序"
                                PointerPressed="OnEntryDragPointerPressed">
                          <TextBlock Text="≡"
                                     Foreground="#334155"
                                     FontSize="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding IsNamesViewMode}">
        <ItemsControl x:Name="NamesEntriesItemsControl"
                      ItemsSource="{Binding VisibleEntries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card name-tile"
                      Classes.drag-target="{Binding IsDragPreviewTarget}"
                      Classes.drag-source="{Binding IsDragPreviewSource}"
                      Classes.selected="{Binding IsSelected}"
                      Width="{Binding NameTileWidth}"
                      Height="{Binding NameTileHeight}"
                      ClipToBounds="True"
                      DoubleTapped="OnEntryRowDoubleTapped"
                      DragDrop.AllowDrop="True">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="启动"
                              Command="{Binding LaunchCommand}"/>
                    <MenuItem Header="预演"
                              Command="{Binding DryRunCommand}"/>
                    <MenuItem Header="上移排序"
                              Command="{Binding MoveUpCommand}"/>
                    <MenuItem Header="下移排序"
                              Command="{Binding MoveDownCommand}"/>
                    <MenuItem Header="编辑"
                              Command="{Binding EditCommand}"/>
                    <MenuItem Header="删除"
                              Command="{Binding DeleteCommand}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="6"
                      VerticalAlignment="Center">
                  <Border Grid.ColumnSpan="3"
                          Classes="drag-insert"
                          ZIndex="10"
                          Width="3"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertBefore}"/>
                  <Border Grid.ColumnSpan="3"
                          Classes="drag-insert"
                          ZIndex="10"
                          Width="3"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding IsDragInsertAfter}"/>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Classes="name-title"
                             ToolTip.Tip="{Binding Name}"
                             MaxLines="1"
                             VerticalAlignment="Center"
                             Text="{Binding Name}"/>
                  <Border Grid.Column="2"
                          Classes="entry-drag-handle"
                          Cursor="Hand"
                          ToolTip.Tip="拖拽排序"
                          AutomationProperties.Name="拖拽排序"
                          PointerPressed="OnEntryDragPointerPressed">
                    <TextBlock Text="≡"
                               Foreground="#64748B"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2"
            Background="White"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="16">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Classes="mono"
                   Text="{Binding DryRunText}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
