<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WTLauncher.App.Views.MainWindow"
        Title="WT Launcher"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="600"
        Background="#F8FAFC"
        DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="13"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #120F172A"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card.compact">
      <Setter Property="Padding" Value="12"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.card.micro">
      <Setter Property="Padding" Value="10"/>
      <Setter Property="CornerRadius" Value="11"/>
    </Style>
    <Style Selector="Border.card.drag-target">
      <Setter Property="BorderBrush" Value="#38BDF8"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Border.card.drag-source">
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Grid.entry-header">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="Border.confirm-badge">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.confirm-badge.manual-confirm">
      <Setter Property="Background" Value="#FEF3C7"/>
    </Style>
    <Style Selector="Border.confirm-badge.danger">
      <Setter Property="Background" Value="#FFEDD5"/>
    </Style>
    <Style Selector="Border.card.compact Border.confirm-badge">
      <Setter Property="Height" Value="21"/>
      <Setter Property="Padding" Value="9,0"/>
    </Style>
    <Style Selector="Border.card.micro Border.confirm-badge">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="TextBlock.confirm-badge-text">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.confirm-badge-text.manual-confirm">
      <Setter Property="Foreground" Value="#92400E"/>
    </Style>
    <Style Selector="TextBlock.confirm-badge-text.danger">
      <Setter Property="Foreground" Value="#9A3412"/>
    </Style>
    <Style Selector="TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Grid.entry-actions">
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>
    <Style Selector="Grid.entry-footer">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-dir">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact TextBlock.entry-cmd">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-actions">
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Grid.entry-footer">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-actions">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="Border.card.micro Grid.entry-footer">
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="Border.card.compact Button.primary">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.card.micro Button.primary">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.more">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="40"/>
    </Style>
    <Style Selector="Border.card.compact Button.more">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.card.micro Button.more">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.entry-drag-handle">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.card.compact Border.entry-drag-handle">
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.card.micro Border.entry-drag-handle">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#EEF2FF"/>
      <Setter Property="Foreground" Value="#1D4ED8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="WT Launcher"/>
        <TextBlock Classes="muted"
                   Text="绿色便携启动器 · 搜索、勾选、一键启动"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Top">
        <Border Background="#ECFDF5"
                CornerRadius="14"
                Padding="12,8"
                VerticalAlignment="Center">
          <TextBlock Foreground="#047857">
            <Run Text="已勾选 "/>
            <Run Text="{Binding SelectedCount}"/>
            <Run Text=" 项"/>
          </TextBlock>
        </Border>
        <Border Background="#FFEDD5"
                CornerRadius="14"
                Padding="12,8"
                VerticalAlignment="Center"
                IsVisible="{Binding HasVisibleDangerous}"
                ToolTip.Tip="橙色：危险命令（命令包含 dangerously 等高风险标记，启动前将强制确认）">
          <TextBlock Foreground="#9A3412">
            <Run Text="危险 "/>
            <Run Text="{Binding VisibleDangerousCount}"/>
            <Run Text=" 项"/>
          </TextBlock>
        </Border>
        <Border Background="#FEF3C7"
                CornerRadius="14"
                Padding="12,8"
                VerticalAlignment="Center"
                IsVisible="{Binding HasVisibleManualConfirm}"
                ToolTip.Tip="黄色：手动设置为“启动前需要确认”的启动项（非危险命令自动判断）">
          <TextBlock Foreground="#92400E">
            <Run Text="需确认 "/>
            <Run Text="{Binding VisibleManualConfirmCount}"/>
            <Run Text=" 项"/>
          </TextBlock>
        </Border>
        <Button Classes="secondary"
                Content="全选可见"
                Command="{Binding SelectVisibleCommand}"/>
        <Button Classes="secondary"
                Content="清空"
                Command="{Binding ClearSelectionCommand}"/>
        <Button Classes="primary"
                Content="一键启动已勾选"
                Command="{Binding LaunchSelectedCommand}"/>
        <Button Classes="secondary"
                Content="重新加载"
                Command="{Binding RefreshCommand}"/>
      </StackPanel>
      <TextBlock Grid.Row="1"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding ConfigPathDisplay}"/>
      <Grid Grid.Row="2"
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,Auto,Auto,Auto"
            Margin="0,12,0,0">
        <TextBox PlaceholderText="搜索名称、目录或命令"
                 Text="{Binding FilterText, Mode=TwoWay}"
                 FontSize="16"
                 Padding="12,8"/>
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Presets}"
                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                  Width="220"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  PlaceholderText="选择启动组"/>
        <Button Grid.Column="2"
                Classes="secondary"
                Content="{Binding ApplyPresetButtonText}"
                Command="{Binding ApplyPresetCommand}"
                Margin="10,0,0,0"/>
        <Border Grid.Column="3"
                Background="#E0F2FE"
                CornerRadius="14"
                Padding="12,7"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Foreground="#0369A1">
            <Run Text="{Binding VisibleCount}"/>
            <Run Text=" / "/>
            <Run Text="{Binding TotalCount}"/>
          </TextBlock>
        </Border>
      </Grid>
      <StackPanel Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Orientation="Horizontal"
                  Spacing="10"
                  Margin="0,10,0,0">
        <Button Classes="primary"
                Content="新增按钮"
                Command="{Binding AddEntryCommand}"/>
        <Button Classes="secondary"
                Content="保存为新启动组"
                Command="{Binding SaveSelectionAsPresetCommand}"/>
        <Button Classes="secondary"
                Content="更新当前启动组"
                Command="{Binding UpdateSelectedPresetCommand}"/>
        <Button Classes="secondary"
                Content="删除当前启动组"
                Command="{Binding DeleteSelectedPresetCommand}"/>
        <TextBlock Text="排序"
                   Classes="muted"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"/>
        <ComboBox ItemsSource="{Binding SortModes}"
                  SelectedItem="{Binding SelectedSortMode, Mode=TwoWay}"
                  Width="150"
                  VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Row="4"
                 Grid.ColumnSpan="2"
                 Margin="0,8,0,0"
                 Classes="muted"
                 Text="{Binding PresetSelectionStatusText}"/>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  Margin="0,16,0,14"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding VisibleEntries}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="10" LineSpacing="10"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card"
                    Classes.drag-target="{Binding IsDragPreviewTarget}"
                    Classes.drag-source="{Binding IsDragPreviewSource}"
                    Classes.compact="{Binding IsCompactLayout}"
                    Classes.micro="{Binding IsMicroLayout}"
                    Width="{Binding CardWidth}"
                    Height="{Binding CardHeight}"
                    ClipToBounds="True"
                    DragDrop.AllowDrop="True">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="启动"
                            Command="{Binding LaunchCommand}"/>
                  <MenuItem Header="预演"
                            Command="{Binding DryRunCommand}"/>
                  <MenuItem Header="编辑"
                            Command="{Binding EditCommand}"/>
                  <MenuItem Header="删除"
                            Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <Border Grid.RowSpan="4"
                        Width="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        CornerRadius="2"
                        Background="#38BDF8"
                        Opacity="0.9"
                        IsHitTestVisible="False"
                        IsVisible="{Binding IsDragInsertBefore}"/>
                <Border Grid.RowSpan="4"
                        Width="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        CornerRadius="2"
                        Background="#38BDF8"
                        Opacity="0.9"
                        IsHitTestVisible="False"
                        IsVisible="{Binding IsDragInsertAfter}"/>
                <Grid Classes="entry-header"
                      ColumnDefinitions="Auto,*,Auto">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Margin="8,0,0,0"
                             Classes="card-title"
                             FontSize="{Binding TitleFontSize}"
                             VerticalAlignment="Center"
                             Text="{Binding Name}"/>
                  <Border Grid.Column="2"
                          Classes="confirm-badge danger"
                          IsVisible="{Binding IsDangerous}"
                          ToolTip.Tip="危险命令：包含 dangerously 等高风险标记，启动前将强制确认">
                    <TextBlock Classes="confirm-badge-text danger"
                               Text="危险"/>
                  </Border>
                  <Border Grid.Column="2"
                          Classes="confirm-badge manual-confirm"
                          IsVisible="{Binding IsManualConfirmation}"
                          ToolTip.Tip="手动确认：该启动项被设置为启动前需要确认">
                    <TextBlock Classes="confirm-badge-text manual-confirm"
                               Text="需确认"/>
                  </Border>
                </Grid>
                <StackPanel Grid.Row="1"
                            ClipToBounds="True">
                  <TextBlock Classes="mono entry-dir"
                             IsVisible="{Binding ShowDirectory}"
                             MaxLines="1"
                             TextTrimming="PathSegmentEllipsis"
                             Text="{Binding Directory}"/>
                  <TextBlock Classes="mono entry-cmd"
                             IsVisible="{Binding ShowCommand}"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Command}"/>
                </StackPanel>
                <Grid Grid.Row="2"
                      Classes="entry-actions"
                      ColumnDefinitions="*,Auto"
                      >
                  <Button Classes="primary"
                          Content="启动"
                          Command="{Binding LaunchCommand}"/>
                  <Button Grid.Column="1"
                          Classes="secondary more"
                          Content="⋯"
                          Margin="8,0,0,0"
                          Click="OnEntryMoreClicked"/>
                </Grid>
                <Grid Grid.Row="3"
                      Classes="entry-footer"
                      ColumnDefinitions="*,Auto">
                  <TextBlock Classes="muted"
                             IsVisible="{Binding ShowUpdatedLabel}"
                             Text="{Binding UpdatedLabel}"/>
                  <Border Grid.Column="1"
                          Classes="entry-drag-handle"
                          Cursor="Hand"
                          PointerPressed="OnEntryDragPointerPressed">
                    <TextBlock Text="拖拽"
                               Foreground="#334155"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="White"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Padding="16">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Classes="mono"
                   Text="{Binding DryRunText}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
