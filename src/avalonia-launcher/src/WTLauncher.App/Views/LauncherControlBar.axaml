<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
             x:Class="WTLauncher.App.Views.LauncherControlBar"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto">
    <!-- 命令栏：一行吃下高频，低频全部收进 ⋯ -->
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <AutoCompleteBox x:Name="SearchTextBox"
                       automation:AutomationProperties.Name="{Binding BarSearch}"
                       PlaceholderText="{Binding BarSearchPlaceholder}"
                       Text="{Binding FilterText, Mode=TwoWay}"
                       ItemsSource="{Binding SearchHistoryItems}"
                       MinimumPrefixLength="1"
                       MinimumPopulateDelay="0:0:0.150"
                       IsTextCompletionEnabled="False"
                       Padding="12,8" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1"
                automation:AutomationProperties.Name="{Binding BarSort}"
                ItemsSource="{Binding SortModes}"
                SelectedItem="{Binding SelectedSortMode, Mode=TwoWay}"
                MinWidth="100" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="2" x:Name="DisplayModeComboBox"
                automation:AutomationProperties.Name="{Binding BarView}"
                ItemsSource="{Binding DisplayModes}"
                SelectedItem="{Binding SelectedDisplayMode, Mode=TwoWay}"
                MinWidth="90" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="3"
                automation:AutomationProperties.Name="{Binding BarCardsGroup}"
                IsVisible="{Binding IsCardsViewMode}"
                ItemsSource="{Binding CardsGroupOptions}"
                SelectedItem="{Binding SelectedCardsGroupOption, Mode=TwoWay}"
                DisplayMemberBinding="{Binding Display}" MinWidth="90" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="4"
                automation:AutomationProperties.Name="{Binding BarPresetGroup}"
                ItemsSource="{Binding Presets}"
                SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                MinWidth="110" VerticalAlignment="Center" PlaceholderText="{Binding BarPresetPlaceholder}"/>
      <Button Grid.Column="5" Classes="secondary" VerticalAlignment="Center"
              Content="{Binding ApplyPresetButtonText}" Command="{Binding ApplyPresetCommand}"/>
      <Border Grid.Column="6" Background="{StaticResource BadgeSuccessBackgroundBrush}" CornerRadius="{StaticResource BadgeCornerRadius}"
              Padding="10,6" VerticalAlignment="Center">
        <TextBlock Foreground="{StaticResource BadgeSuccessForegroundBrush}">
          <Run Text="{Binding BarSelectedPrefix}"/><Run Text="{Binding SelectedCount}"/><Run Text="{Binding BarSelectedSuffix}"/>
        </TextBlock>
      </Border>
      <Button Grid.Column="7" Classes="accent" VerticalAlignment="Center"
              Content="{Binding BarLaunchSelected}" Command="{Binding LaunchSelectedCommand}"/>
      <Button Grid.Column="8" Classes="more" VerticalAlignment="Center"
              automation:AutomationProperties.Name="{Binding BarManageAutomation}"
              Click="OnOverflowMenuClicked">
        <Path Data="{StaticResource IconSettings}"
              Stroke="{StaticResource TextMutedBrush}"
              StrokeThickness="{StaticResource IconStroke16}"
              Fill="Transparent"
              Width="16" Height="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{Binding BarAddEntry}"
                      automation:AutomationProperties.Name="{Binding BarAddEntry}"
                      Command="{Binding AddEntryCommand}"/>
            <MenuItem Header="{Binding BarDiscover}"
                      automation:AutomationProperties.Name="{Binding BarDiscover}"
                      Command="{Binding DiscoverAgentsCommand}"/>
            <Separator/>
            <MenuItem Header="{Binding BarPreview}"
                      automation:AutomationProperties.Name="{Binding BarPreview}"
                      Command="{Binding PreviewSelectedPresetCommand}"/>
            <MenuItem Header="{Binding BarSaveAsNewPreset}"
                      automation:AutomationProperties.Name="{Binding BarSaveAsNewPresetAutomation}"
                      Command="{Binding SaveSelectionAsPresetCommand}"/>
            <MenuItem Header="{Binding BarUpdatePreset}"
                      automation:AutomationProperties.Name="{Binding BarUpdatePresetAutomation}"
                      Command="{Binding UpdateSelectedPresetCommand}"/>
            <MenuItem Header="{Binding BarDeletePreset}"
                      automation:AutomationProperties.Name="{Binding BarDeletePresetAutomation}"
                      Command="{Binding DeleteSelectedPresetCommand}"/>
            <Separator/>
            <MenuItem Header="{Binding BarSelectAll}"
                      automation:AutomationProperties.Name="{Binding BarSelectAll}"
                      Command="{Binding SelectVisibleCommand}"/>
            <MenuItem Header="{Binding BarClearSelection}"
                      automation:AutomationProperties.Name="{Binding BarClearSelection}"
                      Command="{Binding ClearSelectionCommand}"/>
            <MenuItem Header="{Binding BarReload}"
                      automation:AutomationProperties.Name="{Binding BarReload}"
                      Command="{Binding RefreshCommand}"/>
            <Separator/>
            <MenuItem Header="{Binding LaunchConfirmationToggleText}"
                      automation:AutomationProperties.Name="{Binding LaunchConfirmationToggleText}"
                      IsChecked="{Binding RequireConfirmationForLaunches, Mode=TwoWay}"/>
            <Separator/>
            <MenuItem Header="{Binding BarExportAll}"
                      automation:AutomationProperties.Name="{Binding BarExportAllAutomation}"
                      Command="{Binding ExportAllConfigCommand}"/>
            <MenuItem Header="{Binding BarExportSelected}"
                      automation:AutomationProperties.Name="{Binding BarExportSelectedAutomation}"
                      Command="{Binding ExportSelectedConfigCommand}"/>
            <MenuItem Header="{Binding BarImport}"
                      automation:AutomationProperties.Name="{Binding BarImportAutomation}"
                      Command="{Binding ImportConfigCommand}"/>
            <MenuItem Header="{Binding BarRunHistory}"
                      automation:AutomationProperties.Name="{Binding BarRunHistoryAutomation}"
                      Command="{Binding OpenRunHistoryCommand}"/>
            <MenuItem Header="{Binding BarCheckUpdate}"
                      automation:AutomationProperties.Name="{Binding BarCheckUpdateAutomation}"
                      Command="{Binding CheckForUpdatesCommand}"/>
            <MenuItem Header="{Binding BarCommands}"
                      automation:AutomationProperties.Name="{Binding BarCommandsAutomation}"
                      Command="{Binding OpenCommandManagementCommand}"/>
            <MenuItem Header="{Binding BarAddress}"
                      automation:AutomationProperties.Name="{Binding BarAddressAutomation}"
                      Command="{Binding OpenDirectoryManagementCommand}"/>
            <MenuItem Header="{Binding BarAccentColor}"
                      automation:AutomationProperties.Name="{Binding BarAccentColorAutomation}"
                      Command="{Binding OpenAccentColorCommand}"/>
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
    </Grid>

    <!-- 底部状态行：可信信号 + 状态 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
      <TextBlock Classes="muted" Text="{Binding ConfigPathDisplay}" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Border Background="{StaticResource BadgeWarningBackgroundBrush}" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="10,6"
                VerticalAlignment="Center"
                IsVisible="{Binding HasStaleDirectories}"
                ToolTip.Tip="{Binding BarStaleTooltip}">
          <TextBlock Foreground="{StaticResource BadgeWarningForegroundBrush}">
            <Run Text="{Binding BarStalePrefix}"/><Run Text="{Binding StaleDirectoryCount}"/><Run Text="{Binding BarStaleSuffix}"/>
          </TextBlock>
        </Border>
        <Border Background="{StaticResource BadgeInfoBackgroundBrush}" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="10,6"
                VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource BadgeInfoForegroundBrush}">
            <Run Text="{Binding VisibleCount}"/><Run Text=" / "/><Run Text="{Binding TotalCount}"/>
          </TextBlock>
        </Border>
        <TextBlock Classes="muted" Text="{Binding PresetSelectionStatusText}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
