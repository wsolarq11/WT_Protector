<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WTLauncher.App.Views"
             xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="clr-namespace:WTLauncher.App.ViewModels"
             x:Class="WTLauncher.App.Views.LauncherEntriesView"
             x:DataType="vm:MainWindowViewModel">
<Grid Grid.Row="1"
      Margin="0,16,0,14">
  <ScrollViewer x:Name="CardsScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                IsVisible="{Binding IsCardsViewMode}">
    <Grid>
    <ItemsControl x:Name="CardsEntriesItemsControl"
                  ItemsSource="{Binding VisibleGroups}"
                  IsVisible="{Binding IsCardsViewMode}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LauncherCardGroupViewModel">
          <StackPanel Spacing="6">
            <!-- Group header (hidden when groupKey=none) -->
            <Border IsVisible="{Binding ShowHeader}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                    ColumnSpacing="8"
                    VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Classes="secondary"
                        Command="{Binding ToggleExpandedCommand}"
                        Padding="8,2"
                        MinWidth="32"
                        ToolTip.Tip="{Binding GroupCollapseTooltip}">
                  <Grid>
                    <Path Data="{StaticResource IconChevronDown}"
                          Stroke="{StaticResource SecondaryButtonForegroundBrush}"
                          StrokeThickness="2"
                          Fill="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="16" Height="16"
                          IsVisible="{Binding IsExpanded}"/>
                    <Path Data="{StaticResource IconChevronRight}"
                          Stroke="{StaticResource SecondaryButtonForegroundBrush}"
                          StrokeThickness="2"
                          Fill="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="16" Height="16"
                          IsVisible="{Binding !IsExpanded}"/>
                  </Grid>
                </Button>
                <TextBlock Grid.Column="1"
                           Classes="mono"
                           Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="2"
                        Background="{StaticResource BadgeInfoBackgroundBrush}"
                        CornerRadius="8"
                        Padding="8,2"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding CountLabel}" FontSize="11"/>
                </Border>
                <Button Grid.Column="4"
                        Classes="secondary"
                        Content="{Binding LaunchAllLabel}"
                        Command="{Binding LaunchAllCommand}"
                        Padding="8,2"
                        ToolTip.Tip="{Binding LaunchAllTooltip}"/>
                <Button Grid.Column="5"
                        Classes="secondary"
                        Content="{Binding SaveAsPresetLabel}"
                        Command="{Binding SaveAsPresetCommand}"
                        Padding="8,2"
                        ToolTip.Tip="{Binding SaveAsPresetTooltip}"/>
              </Grid>
            </Border>
            <!-- Nested cards in this group -->
            <ItemsControl ItemsSource="{Binding Entries}"
                          IsVisible="{Binding IsExpanded}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <views:FillGridPanel ItemSpacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                                       LineSpacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                                       Columns="{Binding CardColumns}"
                                       ViewportHeight="{Binding CardsViewportHeight}"
                                       ItemHeight="{Binding CardHeight}"
                                       FillViewport="{Binding FillCardsViewportHeight}"
                                       StretchLastRow="True"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LauncherEntryViewModel">
                  <Border Classes="card"
                          Classes.selected="{Binding IsSelected}"
                          Classes.drag-target="{Binding IsDragPreviewTarget}"
                          Classes.drag-source="{Binding IsDragPreviewSource}"
                          Classes.compact="{Binding IsCompactLayout}"
                          Classes.micro="{Binding IsMicroLayout}"
                          Classes.keyboard-focused="{Binding IsKeyboardFocused}"
                          Classes.stale="{Binding IsStaleDirectory}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ClipToBounds="True">
                    <!-- L51: Keyboard accelerators for context menu discoverability -->
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding LaunchLabel}"
                                  AutomationProperties.Name="{Binding LaunchLabel}"
                                  Command="{Binding LaunchCommand}"/>
                        <MenuItem Header="{Binding DryRunLabel}"
                                  AutomationProperties.Name="{Binding DryRunLabel}"
                                  Command="{Binding DryRunCommand}"/>
                        <MenuItem Header="{Binding MoveUpLabel}"
                                  AutomationProperties.Name="{Binding MoveUpLabel}"
                                  InputGesture="Ctrl+Up"
                                  Command="{Binding MoveUpCommand}"/>
                        <MenuItem Header="{Binding MoveDownLabel}"
                                  AutomationProperties.Name="{Binding MoveDownLabel}"
                                  InputGesture="Ctrl+Down"
                                  Command="{Binding MoveDownCommand}"/>
                        <MenuItem Header="{Binding CloneLabel}"
                                  AutomationProperties.Name="{Binding CloneLabel}"
                                  InputGesture="Ctrl+D"
                                  Command="{Binding CloneCommand}"/>
                        <MenuItem Header="{Binding EditLabel}"
                                  AutomationProperties.Name="{Binding EditLabel}"
                                  InputGesture="F2"
                                  Command="{Binding EditCommand}"/>
                        <MenuItem Header="{Binding RepairPathLabel}"
                                  AutomationProperties.Name="{Binding RepairPathLabel}"
                                  IsVisible="{Binding IsStaleDirectory}"
                                  Command="{Binding RepairDirectoryCommand}"/>
                        <MenuItem Header="{Binding DeleteLabel}"
                                  AutomationProperties.Name="{Binding DeleteLabel}"
                                  InputGesture="Delete"
                                  Command="{Binding DeleteCommand}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                      <Border Grid.RowSpan="4"
                              Classes="stale-badge"
                              Background="{StaticResource BadgeWarningBackgroundBrush}"
                              CornerRadius="6"
                              Padding="6,2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,6,6,0"
                              IsVisible="{Binding IsStaleDirectory}"
                              ZIndex="20"
                              ToolTip.Tip="{Binding StaleTooltip}">
                        <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource BadgeWarningForegroundBrush}"
                                   Text="{Binding StaleBadge}"/>
                      </Border>
                      <Border Grid.RowSpan="4"
                              Classes="drag-insert"
                              Width="4"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              IsVisible="{Binding IsDragInsertBefore}"/>
                      <Border Grid.RowSpan="4"
                              Classes="drag-insert"
                              Width="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              IsVisible="{Binding IsDragInsertAfter}"/>
                      <Grid Classes="entry-header"
                            ColumnDefinitions="Auto,Auto,*">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Width="{StaticResource BrandBadgeSize}"
                                Height="{StaticResource BrandBadgeSize}"
                                CornerRadius="{StaticResource BrandBadgeCornerRadius}"
                                Background="{Binding BrandColorHex}"
                                Margin="8,0,0,0"
                                IsVisible="{Binding HasBrand}"
                                VerticalAlignment="Center">
                          <TextBlock Foreground="{StaticResource BrandBadgeForegroundBrush}"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Text="{Binding BrandGlyph}"/>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Classes="card-title"
                                   FontSize="{Binding TitleFontSize}"
                                   VerticalAlignment="Center"
                                   Text="{Binding Name}"/>
                      </Grid>
                      <StackPanel Grid.Row="1"
                                  ClipToBounds="True">
                        <TextBlock Classes="mono entry-dir"
                                   IsVisible="{Binding ShowDirectory}"
                                   MaxLines="1"
                                   TextTrimming="PathSegmentEllipsis"
                                   Text="{Binding Directory}"/>
                        <TextBlock Classes="mono entry-cmd"
                                   IsVisible="{Binding ShowCommand}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Command}"/>
                      </StackPanel>
                      <Grid Grid.Row="2"
                            Classes="entry-actions"
                            ColumnDefinitions="*,Auto">
                        <Button Classes="primary"
                                Content="{Binding LaunchLabel}"
                                AutomationProperties.Name="{Binding LaunchLabel}"
                                Command="{Binding LaunchCommand}"/>
                        <Button Grid.Column="1"
                                Classes="secondary more"
                                Margin="8,0,0,0"
                                ToolTip.Tip="{Binding MoreLabel}"
                                AutomationProperties.Name="{Binding MoreLabel}"
                                Click="OnEntryMoreClicked">
                          <Path Data="{StaticResource IconMoreVertical}"
                                Stroke="{StaticResource SecondaryButtonForegroundBrush}"
                                StrokeThickness="2"
                                Fill="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="16" Height="16"/>
                        </Button>
                      </Grid>
                      <Grid Grid.Row="3"
                            Classes="entry-footer">
                        <Border Classes="entry-drag-handle"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                ToolTip.Tip="{Binding DragSortLabel}"
                                AutomationProperties.Name="{Binding DragSortLabel}"
                                PointerPressed="OnEntryDragPointerPressed">
                          <Path Data="{StaticResource IconGripVertical}"
                                Stroke="{StaticResource DragHandleTextBrush}"
                                StrokeThickness="2"
                                Fill="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="16" Height="16"/>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- L47: Intentional z-order overlay — empty-state TextBlock and ItemsControl
         are siblings in a single-cell Grid. IsVisible binding ensures only one is
         visible at any time, so there is no visual overlap during normal use.
         R4: filtered-empty (entries exist, none match) keeps the text line;
         zero entries at all is handled by the shared welcome panel below. -->
    <TextBlock x:Name="EmptyStateCardsText"
               AutomationProperties.Name="{Binding NoMatchAutomation}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="{StaticResource FontSizeEmphasis}"
               Foreground="{StaticResource TextMutedBrush}"
               Text="{Binding NoMatchText}"
               IsVisible="{Binding IsFilteredEmpty}"/>
  </Grid>
  </ScrollViewer>

  <Grid IsVisible="{Binding IsDetailedListMode}">
    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="{StaticResource CardBorderRadius}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="detail-header"
                CornerRadius="{StaticResource CardBorderRadius}"
                IsVisible="{Binding !IsVisibleEmpty}">
          <Grid ColumnSpacing="12"
                VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="{StaticResource DetailsNameColumnWidth}"/>
              <ColumnDefinition Width="{StaticResource DetailsDirectoryColumnWidth}"/>
              <ColumnDefinition Width="{StaticResource DetailsCommandColumnWidth}"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- L48: Decorative checkbox for visual column alignment only.
                 Not interactive — blocked from hit-testing and focus to avoid
                 confusing screen readers and keyboard navigation. -->
            <CheckBox IsEnabled="False"
                      Opacity="0"
                      IsHitTestVisible="False"
                      Focusable="False"/>
            <TextBlock Grid.Column="1"
                       Classes="detail-header-text"
                       Text="{Binding DetailNameLabel}"/>
            <TextBlock Grid.Column="2"
                       Classes="detail-header-text"
                       Text="{Binding DetailDirectoryLabel}"/>
            <TextBlock Grid.Column="3"
                       Classes="detail-header-text"
                       Text="{Binding DetailCommandLabel}"/>
          </Grid>
        </Border>

        <ListBox x:Name="DetailsEntriesItemsControl"
                 Grid.Row="1"
                 Classes="details-list"
                 ItemsSource="{Binding VisibleEntries}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LauncherEntryViewModel">
              <Border Classes="card detail-row"
                      Classes.drag-target="{Binding IsDragPreviewTarget}"
                      Classes.drag-source="{Binding IsDragPreviewSource}"
                      Classes.selected="{Binding IsSelected}"
                      Classes.keyboard-focused="{Binding IsKeyboardFocused}"
                      Classes.stale="{Binding IsStaleDirectory}"
                      ClipToBounds="True"
                      HorizontalAlignment="Stretch"
                      DoubleTapped="OnEntryRowDoubleTapped">
                <!-- L51: Keyboard accelerators for context menu discoverability -->
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding LaunchLabel}"
                              AutomationProperties.Name="{Binding LaunchLabel}"
                              Command="{Binding LaunchCommand}"/>
                    <MenuItem Header="{Binding DryRunLabel}"
                              AutomationProperties.Name="{Binding DryRunLabel}"
                              Command="{Binding DryRunCommand}"/>
                    <MenuItem Header="{Binding MoveUpLabel}"
                              AutomationProperties.Name="{Binding MoveUpLabel}"
                              InputGesture="Ctrl+Up"
                              Command="{Binding MoveUpCommand}"/>
                    <MenuItem Header="{Binding MoveDownLabel}"
                              AutomationProperties.Name="{Binding MoveDownLabel}"
                              InputGesture="Ctrl+Down"
                              Command="{Binding MoveDownCommand}"/>
                    <MenuItem Header="{Binding CloneLabel}"
                              AutomationProperties.Name="{Binding CloneLabel}"
                              InputGesture="Ctrl+D"
                              Command="{Binding CloneCommand}"/>
                    <MenuItem Header="{Binding EditLabel}"
                              AutomationProperties.Name="{Binding EditLabel}"
                              InputGesture="F2"
                              Command="{Binding EditCommand}"/>
                        <MenuItem Header="{Binding RepairPathLabel}"
                                  AutomationProperties.Name="{Binding RepairPathLabel}"
                                  IsVisible="{Binding IsStaleDirectory}"
                                  Command="{Binding RepairDirectoryCommand}"/>
                    <MenuItem Header="{Binding DeleteLabel}"
                              AutomationProperties.Name="{Binding DeleteLabel}"
                              InputGesture="Delete"
                              Command="{Binding DeleteCommand}"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnSpacing="12"
                      VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{StaticResource DetailsNameColumnWidth}"/>
                    <ColumnDefinition Width="{StaticResource DetailsDirectoryColumnWidth}"/>
                    <ColumnDefinition Width="{StaticResource DetailsCommandColumnWidth}"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- insertion preview -->
                  <Border Grid.ColumnSpan="5"
                          Classes="drag-insert"
                          ZIndex="10"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          IsVisible="{Binding IsDragInsertBefore}"/>
                  <Border Grid.ColumnSpan="5"
                          Classes="drag-insert"
                          ZIndex="10"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom"
                          IsVisible="{Binding IsDragInsertAfter}"/>

                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center"/>

                  <TextBlock Grid.Column="1"
                             Classes="card-title"
                             FontSize="{Binding TitleFontSize}"
                             MaxLines="1"
                             ToolTip.Tip="{Binding Name}"
                             Text="{Binding Name}"/>

                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="6"
                              VerticalAlignment="Center">
                    <TextBlock Classes="mono"
                               MaxLines="1"
                               TextTrimming="PathSegmentEllipsis"
                               ToolTip.Tip="{Binding Directory}"
                               Text="{Binding Directory}"/>
                    <Border Background="{StaticResource BadgeWarningBackgroundBrush}"
                            CornerRadius="4"
                            Padding="4,1"
                            IsVisible="{Binding IsStaleDirectory}"
                            VerticalAlignment="Center">
                      <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                 Foreground="{StaticResource BadgeWarningForegroundBrush}"
                                 Text="{Binding StaleBadge}"/>
                    </Border>
                  </StackPanel>

                  <TextBlock Grid.Column="3"
                             Classes="mono"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Command}"
                             Text="{Binding Command}"/>

                  <StackPanel Grid.Column="4"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <Button Classes="primary"
                            Content="{Binding LaunchLabel}"
                            AutomationProperties.Name="{Binding LaunchLabel}"
                            Command="{Binding LaunchCommand}"/>
                    <Button Classes="secondary more"
                            ToolTip.Tip="{Binding MoreLabel}"
                            AutomationProperties.Name="{Binding MoreLabel}"
                            Click="OnEntryMoreClicked">
                      <Path Data="{StaticResource IconMoreVertical}"
                            Stroke="{StaticResource SecondaryButtonForegroundBrush}"
                            StrokeThickness="2"
                            Fill="Transparent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="16" Height="16"/>
                    </Button>
                    <Border Classes="entry-drag-handle"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding DragSortLabel}"
                            AutomationProperties.Name="{Binding DragSortLabel}"
                            PointerPressed="OnEntryDragPointerPressed">
                      <Path Data="{StaticResource IconGripVertical}"
                            Stroke="{StaticResource DragHandleTextBrush}"
                            StrokeThickness="2"
                            Fill="Transparent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="16" Height="16"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  <TextBlock x:Name="EmptyStateDetailsText"
             AutomationProperties.Name="{Binding NoMatchAutomation}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             FontSize="{StaticResource FontSizeEmphasis}"
             Foreground="{StaticResource TextMutedBrush}"
             Text="{Binding NoMatchText}"
             IsVisible="{Binding IsFilteredEmpty}"/>
  </Grid>

  <ScrollViewer x:Name="NamesScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                IsVisible="{Binding IsNamesViewMode}">
    <Grid>
    <ItemsControl x:Name="NamesEntriesItemsControl"
                  ItemsSource="{Binding VisibleEntries}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <views:FastWrapPanel ItemSpacing="{x:Static core:LauncherDesignTokens.NameTileGap}" LineSpacing="{x:Static core:LauncherDesignTokens.NameTileRowGap}"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LauncherEntryViewModel">
          <Border Classes="card name-tile"
                  Classes.drag-target="{Binding IsDragPreviewTarget}"
                  Classes.drag-source="{Binding IsDragPreviewSource}"
                  Classes.selected="{Binding IsSelected}"
                  Classes.keyboard-focused="{Binding IsKeyboardFocused}"
                  Classes.stale="{Binding IsStaleDirectory}"
                  Width="{Binding NameTileWidth}"
                  Height="{Binding NameTileHeight}"
                  ClipToBounds="True"
                  DoubleTapped="OnEntryRowDoubleTapped">
            <!-- L51: Keyboard accelerators for context menu discoverability -->
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding LaunchLabel}"
                          AutomationProperties.Name="{Binding LaunchLabel}"
                          Command="{Binding LaunchCommand}"/>
                <MenuItem Header="{Binding DryRunLabel}"
                          AutomationProperties.Name="{Binding DryRunLabel}"
                          Command="{Binding DryRunCommand}"/>
                <MenuItem Header="{Binding MoveUpLabel}"
                          AutomationProperties.Name="{Binding MoveUpLabel}"
                          InputGesture="Ctrl+Up"
                          Command="{Binding MoveUpCommand}"/>
                <MenuItem Header="{Binding MoveDownLabel}"
                          AutomationProperties.Name="{Binding MoveDownLabel}"
                          InputGesture="Ctrl+Down"
                          Command="{Binding MoveDownCommand}"/>
                <MenuItem Header="{Binding CloneLabel}"
                          AutomationProperties.Name="{Binding CloneLabel}"
                          InputGesture="Ctrl+D"
                          Command="{Binding CloneCommand}"/>
                <MenuItem Header="{Binding EditLabel}"
                          AutomationProperties.Name="{Binding EditLabel}"
                          InputGesture="F2"
                          Command="{Binding EditCommand}"/>
                        <MenuItem Header="{Binding RepairPathLabel}"
                                  AutomationProperties.Name="{Binding RepairPathLabel}"
                                  IsVisible="{Binding IsStaleDirectory}"
                                  Command="{Binding RepairDirectoryCommand}"/>
                <MenuItem Header="{Binding DeleteLabel}"
                          AutomationProperties.Name="{Binding DeleteLabel}"
                          InputGesture="Delete"
                          Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </Border.ContextMenu>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6"
                  VerticalAlignment="Center">
              <Border Grid.ColumnSpan="3"
                      Classes="drag-insert"
                      ZIndex="10"
                      Width="3"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"
                      IsVisible="{Binding IsDragInsertBefore}"/>
              <Border Grid.ColumnSpan="3"
                      Classes="drag-insert"
                      ZIndex="10"
                      Width="3"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      IsVisible="{Binding IsDragInsertAfter}"/>
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Classes="name-title"
                         ToolTip.Tip="{Binding Name}"
                         MaxLines="1"
                         VerticalAlignment="Center"
                         Text="{Binding Name}"/>
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="4"
                          VerticalAlignment="Center">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{StaticResource BadgeWarningBackgroundBrush}"
                        IsVisible="{Binding IsStaleDirectory}"
                        ToolTip.Tip="{Binding StaleDotTooltip}"/>
                <Border Classes="entry-drag-handle"
                        Cursor="Hand"
                        ToolTip.Tip="{Binding DragSortLabel}"
                        AutomationProperties.Name="{Binding DragSortLabel}"
                        PointerPressed="OnEntryDragPointerPressed">
                  <Path Data="{StaticResource IconGripVertical}"
                        Stroke="{StaticResource TextMutedBrush}"
                        StrokeThickness="2"
                        Fill="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="14" Height="14"/>
                </Border>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="EmptyStateNamesText"
               AutomationProperties.Name="{Binding NoMatchAutomation}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="{StaticResource FontSizeEmphasis}"
               Foreground="{StaticResource TextMutedBrush}"
               Text="{Binding NoMatchText}"
               IsVisible="{Binding IsFilteredEmpty}"/>
    </Grid>
  </ScrollViewer>

  <!-- R4: first-run welcome panel — zero entries at all. Overlay sibling on the
       root Grid, shown above every view mode. Filtered-empty (entries exist)
       keeps the per-mode "没有匹配的启动项" text instead. -->
  <StackPanel IsVisible="{Binding IsEmptyEntries}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="10"
              MaxWidth="460">
    <TextBlock Classes="h1"
               Text="{Binding WelcomeTitle}"
               HorizontalAlignment="Center"/>
    <TextBlock Classes="muted"
               Text="{Binding WelcomeBody}"
               TextWrapping="Wrap"
               TextAlignment="Center"
               HorizontalAlignment="Center"/>
    <StackPanel Orientation="Horizontal"
                Spacing="10"
                HorizontalAlignment="Center"
                Margin="0,10,0,0">
      <Button Classes="primary"
              Content="{Binding AddFirstLabel}"
              AutomationProperties.Name="{Binding AddFirstAutomation}"
              Command="{Binding AddEntryCommand}"/>
      <Button Classes="secondary"
              Content="{Binding DiscoverToolsLabel}"
              AutomationProperties.Name="{Binding DiscoverToolsAutomation}"
              Command="{Binding DiscoverAgentsCommand}"/>
    </StackPanel>
  </StackPanel>
</Grid>
</UserControl>
