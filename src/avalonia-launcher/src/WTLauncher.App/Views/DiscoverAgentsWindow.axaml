<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        x:Class="WTLauncher.App.Views.DiscoverAgentsWindow"
        Width="780"
        Height="560"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 Classes="dialog-title"
                 Text="发现并添加 AI Agent CLI 启动项"/>
      <TextBlock Grid.Row="1"
                 x:Name="SubtitleText"
                 Margin="0,4,0,12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"
                 Text="扫描 PATH 上的 AI Agent CLI，或复用已有目录和命令模板快速创建启动项。"/>
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="18"
                  Margin="0,0,0,10">
        <RadioButton x:Name="PathModeRadio"
                     GroupName="DiscoveryMode"
                     Content="发现 AI Agent"
                     IsChecked="True"
                     IsCheckedChanged="OnPathModeToggled"/>
        <RadioButton x:Name="DirectoryModeRadio"
                     GroupName="DiscoveryMode"
                     Content="从已有目录创建"
                     IsCheckedChanged="OnDirectoryModeToggled"/>
      </StackPanel>
      <Grid Grid.Row="3">
        <StackPanel x:Name="PathPanel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Button Grid.Column="1"
                    x:Name="ScanButton"
                    Content="重新扫描"
                    Classes="secondary"
                    MinWidth="96"
                    Click="OnScanClicked"
                    automation:AutomationProperties.Name="重新扫描 AI Agent"/>
          </Grid>
          <Border Margin="0,10,0,0"
                  BorderThickness="1"
                  CornerRadius="10"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="RowsPanel" Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}"/>
            </ScrollViewer>
          </Border>
        </StackPanel>
        <StackPanel x:Name="DirectoryPanel"
                    IsVisible="False"
                    Spacing="{x:Static core:LauncherDesignTokens.DialogFooterSpacing}">
          <TextBlock TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="选择一个已在使用的目录："/>
          <Border BorderThickness="1"
                  CornerRadius="10"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Padding="10">
            <ScrollViewer MaxHeight="220">
              <StackPanel x:Name="DirectoryListPanel" Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}"/>
            </ScrollViewer>
          </Border>
          <TextBlock TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="命令模板"/>
          <ComboBox x:Name="CommandPicker"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnCommandTemplateChanged"/>
          <TextBlock TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="启动项名称"/>
          <TextBox x:Name="EntryNameBox"
                   PlaceholderText="启动项名称"
                   TextChanged="OnEntryNameChanged"/>
          <TextBlock TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="命令预览"/>
          <Border Background="{StaticResource SurfaceBrush}"
                  CornerRadius="8"
                  Padding="10">
            <TextBlock x:Name="CommandPreview"
                       Classes="mono-preview"/>
          </Border>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Content="取消"
                Classes="secondary"
                MinWidth="96"
                IsCancel="True"
                Click="OnCancelClicked"
                automation:AutomationProperties.Name="取消发现 AI Agent"/>
        <Button x:Name="AddButton"
                Content="添加选中"
                Classes="primary"
                MinWidth="132"
                Click="OnAddClicked"
                automation:AutomationProperties.Name="添加选中的 AI Agent"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
