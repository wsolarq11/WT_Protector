<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:core="clr-namespace:WTLauncher.Core;assembly=WTLauncher.Core"
        x:Class="WTLauncher.App.Views.DiscoverAgentsWindow"
        Width="780"
        Height="560"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0"
                 x:Name="HeadingText"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 x:Name="SubtitleText"
                 Margin="0,4,0,12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="18"
                  Margin="0,0,0,10">
        <RadioButton x:Name="PathModeRadio"
                     GroupName="DiscoveryMode"
                     IsChecked="True"
                     IsCheckedChanged="OnPathModeToggled"/>
        <RadioButton x:Name="DirectoryModeRadio"
                     GroupName="DiscoveryMode"
                     IsCheckedChanged="OnDirectoryModeToggled"/>
      </StackPanel>
      <Grid Grid.Row="3">
        <StackPanel x:Name="PathPanel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Button Grid.Column="1"
                    x:Name="ScanButton"
                    Classes="secondary"
                    MinWidth="96"
                    Click="OnScanClicked"/>
          </Grid>
          <Border Margin="0,10,0,0"
                  BorderThickness="1"
                  CornerRadius="10"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="RowsPanel" Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}"/>
            </ScrollViewer>
          </Border>
        </StackPanel>
        <StackPanel x:Name="DirectoryPanel"
                    IsVisible="False"
                    Spacing="{x:Static core:LauncherDesignTokens.DialogFooterSpacing}">
          <TextBlock x:Name="DirectoryHintText"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"/>
          <Border BorderThickness="1"
                  CornerRadius="10"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  Padding="10">
            <ScrollViewer MaxHeight="220">
              <StackPanel x:Name="DirectoryListPanel" Spacing="{x:Static core:LauncherDesignTokens.NameTileGap}"/>
            </ScrollViewer>
          </Border>
          <TextBlock x:Name="CommandTemplateLabel"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"/>
          <ComboBox x:Name="CommandPicker"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnCommandTemplateChanged"/>
          <TextBlock x:Name="EntryNameLabel"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"/>
          <TextBox x:Name="EntryNameBox"
                   TextChanged="OnEntryNameChanged"/>
          <TextBlock x:Name="CommandPreviewLabel"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource TextMutedBrush}"/>
          <Border Background="{StaticResource SurfaceBrush}"
                  CornerRadius="8"
                  Padding="10">
            <TextBlock x:Name="CommandPreview"
                       Classes="mono-preview"/>
          </Border>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{x:Static core:LauncherDesignTokens.SpacingSmall}"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button x:Name="CancelButton"
                Classes="secondary"
                MinWidth="96"
                IsCancel="True"
                Click="OnCancelClicked"/>
        <Button x:Name="AddButton"
                Classes="accent"
                MinWidth="132"
                Click="OnAddClicked"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
