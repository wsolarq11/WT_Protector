<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="WTLauncher.App.Views.ConfirmPresetDeleteWindow"
        Width="560"
        Height="280"
        MinWidth="460"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
      <TextBlock Grid.Row="0"
                 x:Name="HeadingText"
                 Classes="dialog-title"/>
      <TextBlock Grid.Row="1"
                 x:Name="BodyText"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <TextBlock Grid.Row="2"
                 x:Name="SubtleText"
                 Foreground="{StaticResource TextMutedBrush}"/>
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Classes="secondary"
                MinWidth="90"
                IsDefault="True"
                IsCancel="True"
                x:Name="CancelButton"
                Click="OnCancelClicked"/>
        <Button Classes="destructive"
                MinWidth="110"
                x:Name="DeleteButton"
                Click="OnDeleteClicked"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
