<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="WTLauncher.App.Views.DirectoryEditDialog"
        Width="600"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
  <Window.Styles>
    <StyleInclude Source="/Views/Dialogs/DialogSharedStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{StaticResource DialogOuterPadding}">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <TextBlock Grid.Row="0"
                 x:Name="TitleText"
                 Margin="0,0,0,12"
                 Classes="dialog-title"/>
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock x:Name="LabelText"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox Grid.Column="0"
                   x:Name="Input"
                   FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                   FontSize="{StaticResource FontSizeBody}"
                   PlaceholderText="D:\path\to\directory"
                   Padding="10,8"/>
          <Button Grid.Column="2"
                  x:Name="BrowseButton"
                  Content="浏览..."
                  Classes="secondary"
                  MinWidth="100"
                  Click="OnBrowseClicked"
                  automation:AutomationProperties.Name="浏览选择目录"/>
        </Grid>
        <TextBlock x:Name="AffectedHint"
                   IsVisible="False"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource DestructiveBrush}"/>
      </StackPanel>
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="{StaticResource DialogFooterMargin}">
        <Button Content="取消"
                Classes="secondary"
                MinWidth="96"
                IsCancel="True"
                Click="OnCancelClicked"
                automation:AutomationProperties.Name="取消地址编辑"/>
        <Button Content="确定"
                Classes="primary"
                MinWidth="96"
                Click="OnOkClicked"
                automation:AutomationProperties.Name="确认地址编辑"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
