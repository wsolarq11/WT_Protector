<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Ultrareview: 此项目已被标记为孤立项目。
         解决方案中包含此项目，但无 C# 项目引用它。
         F# 类型（LaunchEntry、quoteArgument）与 C# 版本重复但从未消费。
         如需保留，添加 ProjectReference 到 WTLauncher.Core 或移除。
         IsAotCompatible 声明存在 FSharp.Core AOT 兼容性风险。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <_FSharpProjectIsOrphaned>true</_FSharpProjectIsOrphaned>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
