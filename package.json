{
  "name": "wt-protector-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript scripting layer for WT Protector release and verification tooling",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx scripts/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsx scripts/verify.ts",
    "verify:mainline": "tsx scripts/verify-mainline.ts",
    "test:fast": "tsx scripts/test-fast.ts",
    "test:coverage": "tsx scripts/test-coverage.ts",
    "test:launch-args": "tsx scripts/test-launch-args.ts",
    "smoke": "tsx scripts/smoke-critical-journey.ts --exe src/avalonia-launcher/artifacts/verify-publish/win-x64/WTLauncher.App.exe",
    "release:build": "tsx scripts/build-release.ts",
    "release:contract": "tsx scripts/release-contract.ts"
  },
  "dependencies": {
    "execa": "^10.0.1",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
