# Local orchestration/runtime state
.omx/
.snow/
.agents/

# Local backups generated by config/save/build helpers
*.bak

# Machine-specific launcher state (real paths, runtime data — not for version control)
config/launcher.json
*.bak.*
*.bak-*

# Local logs and scratch artifacts
*.log
*.tmp

# Build outputs
artifacts/
src/avalonia-launcher/**/bin/
src/avalonia-launcher/**/obj/
src/avalonia-launcher/**/TestResults/
src/avalonia-launcher/artifacts/

# Auto-captured wiki session logs; promote durable findings manually.
omx_wiki/session-log-*.md
*.db
.claude/
config/*.legacybak
config/*.legacybak2

# Windows shortcuts (local launcher references)
*.lnk
